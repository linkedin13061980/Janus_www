---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Tracking from '../../components/ui/Tracking.astro';
import { actions } from 'astro:actions';
import content from '../../content/fr/contact.json';
const locale = 'fr';
const currentPath = '/contact';
const fr = (s: string) => s.replace(/ ([?;:!])/g, '\u00A0$1');

// Après un envoi réussi du formulaire : redirection vers la page de remerciement,
// qui sert de page de conversion mesurable (GA4 / Google Ads).
// Si la mesure était acceptée lors de l'envoi, un cookie technique à usage unique (10 min, limité à /fr/merci)
// prouve à la page de remerciement que l'envoi a réellement abouti côté serveur.
const envoi = Astro.getActionResult(actions.sendContact);
if (envoi?.data?.success) {
  if (envoi.data.mesure) {
    Astro.cookies.set('janus_conversion', '1', { path: '/fr/merci', maxAge: 600, httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD });
  }
  return Astro.redirect('/fr/merci', 303);
}
---
<Layout
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  currentPath={currentPath}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
  </style>
  <Tracking />

  <section style="background:#1a1a1a" class="pt-20 md:pt-28 pb-20 md:pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-6" style="color:#c9a84c">{content.surtitre}</p>
      <h1 class="hp-serif font-light leading-[1.1] mb-6" style="font-size:clamp(2.1rem,4.5vw,3.4rem);color:#f7f5f2">
        {content.h1}
      </h1>
      <p class="hp-sans text-base md:text-lg leading-[1.7] mb-3 max-w-2xl" style="color:rgba(247,245,242,0.8)">{fr(content.intro)}</p>
      <p class="hp-serif italic text-lg mb-12" style="color:#c9a84c">{content.confidentialite}</p>

      <!-- Coordonnées -->
      <div class="hp-sans flex flex-col sm:flex-row gap-5 sm:gap-8 mb-14 pb-14 border-b" style="border-color:rgba(247,245,242,0.1)">
        <a href={content.coordonnees.telephone.href} data-track="clic_telephone" data-track-position="contact" class="flex items-center gap-3 text-sm hover:opacity-80 transition-opacity" style="color:rgba(247,245,242,0.75)">
          <span style="color:#c9a84c" aria-hidden="true">→</span>{content.coordonnees.telephone.label}
        </a>
        <a href={content.coordonnees.email.href} class="flex items-center gap-3 text-sm hover:opacity-80 transition-opacity" style="color:rgba(247,245,242,0.75)">
          <span style="color:#c9a84c" aria-hidden="true">→</span>{content.coordonnees.email.label}
        </a>
        <span class="flex items-center gap-3 text-sm" style="color:rgba(247,245,242,0.5)">
          <span style="color:rgba(201,168,76,0.5)" aria-hidden="true">→</span>{content.coordonnees.ville}
        </span>
      </div>

      <!-- Formulaire -->
      <ContactForm locale={locale} variante="projet" />
    </div>
  </section>

</Layout>
