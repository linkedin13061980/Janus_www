---
import Layout from '../../../layouts/Layout.astro';
import LanguePage from '../../../components/layout/LanguePage.astro';
import data from '../../../content/fr/langues/polonais.json';
import commun from '../../../content/fr/langues/_commun.json';

// Page FR uniquement : le sélecteur de langue et les hreflang pointent vers /langues (existant en FR/EN/PL),
// la canonical est la page elle-même.
---

<Layout
  title={data.meta.title}
  description={data.meta.description}
  locale="fr"
  currentPath="/langues"
  canonical={`https://agence-janus.fr/fr/langues/${data.slug}`}
>
  <LanguePage data={data as any} commun={commun as any} />
</Layout>
