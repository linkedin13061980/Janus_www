---
import Layout from '../../layouts/Layout.astro';
import content from '../../content/fr/a-propos.json';

const locale = 'fr';
const currentPath = '/a-propos';

// Typographie française : espace insécable avant « ? ; : ! » et « → », « France–Pologne » insécable.
const fr = (s: string) => s.replace(/ ([?;:!])/g, ' $1').replace(/France–Pologne/g, 'France⁠–⁠Pologne').replace(/ →/g, ' →');

const { hero, fondatrice, janus, principes, international, ctaFinal } = content;

// Données structurées : uniquement des informations publiées sur cette page.
const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Agata Mich',
  jobTitle: 'Dirigeante',
  knowsLanguage: ['fr', 'pl', 'en', 'ru'],
  worksFor: { '@type': 'Organization', name: 'JANUS', legalName: 'MICH', url: 'https://agence-janus.fr/fr/' },
};
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  currentPath={currentPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(personne)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    a { text-decoration: none !important; }
  </style>

  <!-- HERO -->
  <section style="background:#1a1a1a" class="pt-20 md:pt-28 pb-16 md:pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-6" style="color:#c9a84c">{hero.surtitre}</p>
      <h1 class="hp-serif font-light leading-[1.1] mb-6 max-w-4xl" style="font-size:clamp(2.1rem,4.5vw,3.4rem);color:#f7f5f2">
        {hero.h1}
      </h1>
      <p class="hp-sans text-base md:text-lg leading-[1.7] max-w-2xl" style="color:rgba(247,245,242,0.8)">{fr(hero.intro)}</p>
    </div>
  </section>

  <!-- LA DIRIGEANTE -->
  <section class="bg-white py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[7fr_5fr] gap-10 lg:gap-16">
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">{fondatrice.surtitre}</p>
        <h2 class="hp-serif font-light leading-tight mb-8" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{fondatrice.h2}</h2>
        {fondatrice.paragraphes.map((p, i) => (
          <p class={`hp-sans leading-[1.8] ${i === 0 ? 'text-base md:text-lg mb-5' : 'text-sm'}`} style={`color:${i === 0 ? '#1a1a1a' : 'rgba(26,26,26,0.55)'}`}>{p}</p>
        ))}
      </div>
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-5" style="color:#b5936b">{fondatrice.etapesTitre}</p>
        <ol class="border-l-2 pl-6 space-y-6" style="border-left-color:#b5936b">
          {fondatrice.etapes.map((e) => (
            <li>
              <p class="hp-serif text-xl md:text-2xl font-light leading-none mb-2" style="color:#b5936b">{e.repere}</p>
              <p class="hp-sans text-sm leading-[1.7]" style="color:rgba(26,26,26,0.7)">{fr(e.texte)}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- JANUS AUJOURD'HUI -->
  <section style="background:#f7f5f2" class="py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[7fr_5fr] gap-10 lg:gap-16">
      <div>
        <h2 class="hp-serif font-light leading-tight mb-8" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{janus.h2}</h2>
        {janus.paragraphes.map((p) => (
          <p class="hp-sans text-base leading-[1.8] mb-4" style="color:rgba(26,26,26,0.7)">{fr(p)}</p>
        ))}
      </div>
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-5" style="color:#b5936b">{janus.zonesTitre}</p>
        <ul class="border-t" style="border-color:rgba(26,26,26,0.12)">
          {janus.zones.map((z) => (
            <li class="hp-sans text-sm md:text-base py-3 border-b flex gap-4" style="border-color:rgba(26,26,26,0.12);color:#1a1a1a">
              <span class="w-4 h-px mt-3 flex-shrink-0" style="background:#b5936b" aria-hidden="true"></span>
              <span>{z}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- NOTRE MANIÈRE DE TRAVAILLER -->
  <section style="background:#1a1a1a" class="py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="hp-serif font-light leading-tight mb-10 md:mb-12" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#f7f5f2">{principes.h2}</h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background:rgba(247,245,242,0.08)">
        {principes.items.map((p, i) => (
          <li class="p-7 md:p-8" style="background:#1a1a1a">
            <p class="hp-serif font-light leading-none mb-4" style="font-size:2rem;color:#b5936b">0{i + 1}</p>
            <h3 class="hp-sans text-sm font-medium uppercase tracking-[0.15em] mb-3" style="color:#f7f5f2">{p.titre}</h3>
            <p class="hp-sans text-sm leading-[1.7]" style="color:rgba(247,245,242,0.65)">{fr(p.texte)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FRANCE–POLOGNE ET INTERNATIONAL -->
  <section class="bg-white py-16 md:py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="bg-[#f7f5f2] border-l-2 p-8 md:p-10" style="border-left-color:#b5936b">
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">{fr(international.surtitre)}</p>
        <p class="hp-sans text-base md:text-lg leading-[1.8] max-w-3xl mb-6" style="color:#1a1a1a">{international.texte}</p>
        <p class="hp-sans flex flex-wrap gap-x-8 gap-y-3">
          {international.liens.map((l) => (
            <a href={l.href} class="hp-link text-xs uppercase tracking-widest border-b py-1" style="border-color:#b5936b;color:#1a1a1a">{fr(`${l.label} →`)}</a>
          ))}
        </p>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section style="background:#f7f5f2" class="py-24 md:py-28 px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="hp-serif text-3xl md:text-5xl font-light mb-6 leading-tight" style="color:#1a1a1a">{fr(ctaFinal.h2)}</h2>
      <p class="hp-sans text-base mb-10 max-w-lg mx-auto leading-[1.8]" style="color:rgba(26,26,26,0.65)">{ctaFinal.texte}</p>
      <a href={ctaFinal.cta.href} class="hp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
        {fr(ctaFinal.cta.label)}
      </a>
    </div>
  </section>

</Layout>
