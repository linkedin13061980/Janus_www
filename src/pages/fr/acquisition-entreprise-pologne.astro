---
import Layout from '../../layouts/Layout.astro';
import Tracking from '../../components/ui/Tracking.astro';
import content from '../../content/fr/acquisition-pologne.json';

const locale = 'fr';
const currentPath = '/acquisition-entreprise-pologne';

// Typographie française : espace insécable avant « ? ; : ! » et « → », « France–Pologne » insécable.
const fr = (s: string) => s.replace(/ ([?;:!])/g, ' $1').replace(/France–Pologne/g, 'France⁠–⁠Pologne').replace(/ →/g, ' →');

const { hero, enjeux, parcours, dirigeants, integration, coordination, cas, autres, ctaFinal } = content;

// Données structurées : uniquement des informations publiées sur cette page et sur le site.
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Accompagnement linguistique et interculturel d’une acquisition en Pologne',
  description: content.meta.description,
  url: 'https://agence-janus.fr/fr/acquisition-entreprise-pologne',
  serviceType: ['Interprétation', 'Traduction', 'Communication interculturelle', 'Coaching en prise de parole', 'Formation professionnelle en langues'],
  areaServed: [{ '@type': 'Country', name: 'France' }, { '@type': 'Country', name: 'Pologne' }],
  availableLanguage: ['fr', 'pl', 'en', 'de'],
  provider: { '@type': 'Organization', name: 'JANUS', legalName: 'MICH', url: 'https://agence-janus.fr/fr/', telephone: '+33 9 67 05 68 31' },
};
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  currentPath={currentPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(service)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-card { transition: border-color .2s ease, box-shadow .2s ease; }
    .hp-card:hover { border-color: rgba(181,147,107,.6); box-shadow: 0 10px 28px rgba(0,0,0,.05); }
    .hp-card:hover .hp-arrow { color: #b5936b; }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    a { text-decoration: none !important; }
  </style>
  <Tracking />

  <!-- HERO -->
  <section style="background:#1a1a1a" class="pt-20 md:pt-28 pb-16 md:pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="hp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-6 flex items-center gap-4" style="color:#c9a84c">
        <span class="hidden sm:inline-block w-10 h-px flex-shrink-0" style="background:#c9a84c" aria-hidden="true"></span>
        <span>{fr(hero.surtitre)}</span>
      </p>
      <h1 class="hp-serif font-light leading-[1.1] mb-8 max-w-4xl" style="font-size:clamp(2.1rem,4.6vw,3.6rem);color:#f7f5f2">
        {fr(hero.h1)}
      </h1>
      <p class="hp-serif italic text-xl md:text-2xl leading-snug mb-6 max-w-3xl" style="color:#c9a84c">{hero.accroche}</p>
      {hero.paragraphes.map((p) => (
        <p class="hp-sans text-base md:text-lg leading-[1.7] mb-4 max-w-3xl" style="color:rgba(247,245,242,0.8)">{p}</p>
      ))}
      <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8 mt-9">
        <a href={hero.ctaPrincipal.href} data-track="cta_principal" data-track-position="hero" class="hp-sans inline-block text-center px-8 sm:px-10 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">
          {fr(hero.ctaPrincipal.label)}
        </a>
        <a href={hero.ctaSecondaire.href} class="hp-sans hp-link self-start sm:self-auto text-[11px] uppercase tracking-[0.25em] border-b pb-1" style="border-color:rgba(247,245,242,0.35);color:rgba(247,245,242,0.75)">
          {fr(hero.ctaSecondaire.label)}
        </a>
      </div>
      <p class="hp-sans text-xs leading-[1.9] mt-10 pt-6 border-t max-w-4xl" style="border-color:rgba(247,245,242,0.12);color:rgba(247,245,242,0.55)">
        {hero.infos.join(' • ')}
      </p>
    </div>
  </section>

  <!-- 1. UN PROJET, PLUSIEURS ENJEUX -->
  <section class="bg-white py-16 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-8 lg:gap-16 mb-12 md:mb-16">
        <h2 class="hp-serif font-light leading-tight" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{enjeux.h2}</h2>
        <div>
          {enjeux.paragraphes.map((p, i) => (
            <p class={`hp-sans leading-[1.8] mb-4 ${i === 2 ? 'text-base md:text-lg' : 'text-base'}`} style={`color:${i === 2 ? '#1a1a1a' : 'rgba(26,26,26,0.65)'}`}>{p}</p>
          ))}
          <p class="hp-sans text-xs leading-[1.7] mt-6" style="color:rgba(26,26,26,0.5)">{enjeux.perimetre}</p>
        </div>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {enjeux.cartes.map((c, i) => (
          <li>
            <a href={c.href} class="hp-card flex flex-col h-full border p-7 md:p-8 bg-[#f7f5f2] border-[#1a1a1a]/5">
              <p class="hp-serif font-light leading-none mb-5" style="font-size:2rem;color:#b5936b">0{i + 1}</p>
              <h3 class="hp-sans text-sm font-medium uppercase tracking-[0.15em] leading-snug mb-4" style="color:#1a1a1a">{c.titre}</h3>
              <p class="hp-sans text-sm leading-[1.7] mb-5" style="color:rgba(26,26,26,0.62)">{c.texte}</p>
              <span class="hp-arrow hp-sans text-sm mt-auto transition-colors" style="color:rgba(26,26,26,0.3)" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. PARCOURS AVANT / PENDANT / APRÈS -->
  <section style="background:#f7f5f2" class="py-16 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">{parcours.surtitre}</p>
      <h2 class="hp-serif font-light leading-tight mb-12 md:mb-16 max-w-3xl" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{parcours.h2}</h2>
      <ol class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {parcours.etapes.map((e, i) => (
          <li class="flex flex-col bg-white border-t-2 p-7 md:p-9" style="border-top-color:#b5936b">
            <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4 flex items-baseline gap-3" style="color:#b5936b">
              <span class="hp-serif text-4xl font-light tracking-normal leading-none">0{i + 1}</span>
              <span>{e.moment}</span>
            </p>
            <h3 class="hp-serif font-light leading-tight mb-6" style="font-size:clamp(1.5rem,2.3vw,1.9rem);color:#1a1a1a">{e.titre}</h3>
            <ul class="mb-6">
              {e.points.map((pt) => (
                <li class="hp-sans text-sm leading-[1.6] py-2 border-b flex gap-3" style="border-color:rgba(26,26,26,0.08);color:#1a1a1a">
                  <span class="w-3 h-px mt-[0.7em] flex-shrink-0" style="background:#b5936b" aria-hidden="true"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
            <p class="hp-sans text-sm leading-[1.7] mt-auto" style="color:rgba(26,26,26,0.6)">{fr(e.conclusion)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. DIRIGEANTS -->
  <section style="background:#1a1a1a" class="py-16 md:py-28 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#c9a84c">{dirigeants.surtitre}</p>
        <h2 class="hp-serif font-light leading-tight mb-8" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#f7f5f2">{dirigeants.h2}</h2>
        {dirigeants.paragraphes.map((p, i) => (
          <p class={`hp-sans leading-[1.8] mb-4 ${i === 0 ? 'text-lg md:text-xl' : 'text-base'}`} style={`color:${i === 0 ? '#f7f5f2' : 'rgba(247,245,242,0.7)'}`}>{fr(p)}</p>
        ))}
      </div>
      <div class="border p-7 md:p-10" style="border-color:rgba(201,168,76,0.4)">
        <h3 class="hp-serif font-light leading-tight mb-4" style="font-size:clamp(1.4rem,2.2vw,1.8rem);color:#c9a84c">{dirigeants.encadre.titre}</h3>
        <p class="hp-sans text-sm md:text-base leading-[1.7] mb-6" style="color:rgba(247,245,242,0.8)">{dirigeants.encadre.intro}</p>
        <ul class="mb-8">
          {dirigeants.encadre.points.map((pt) => (
            <li class="hp-sans text-sm leading-[1.6] py-2 border-b flex gap-3" style="border-color:rgba(247,245,242,0.1);color:rgba(247,245,242,0.85)">
              <span class="w-3 h-px mt-[0.7em] flex-shrink-0" style="background:#b5936b" aria-hidden="true"></span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
        <a href={dirigeants.encadre.cta.href} data-track="cta_principal" data-track-position="dirigeants" class="hp-sans inline-block text-center px-8 py-4 text-xs uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">
          {fr(dirigeants.encadre.cta.label)}
        </a>
      </div>
    </div>
  </section>

  <!-- 4. INTÉGRATION FRANCE–POLOGNE -->
  <section class="bg-white py-16 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">{fr(integration.surtitre)}</p>
      <h2 class="hp-serif font-light leading-tight mb-8" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{integration.h2}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-8 lg:gap-16 mb-12">
        <p class="hp-sans text-base md:text-lg leading-[1.8]" style="color:#1a1a1a">{fr(integration.intro)}</p>
        <ul class="border-t" style="border-color:rgba(26,26,26,0.1)">
          {integration.situations.map((s) => (
            <li class="hp-sans text-sm md:text-base leading-[1.7] py-3 border-b flex gap-4" style="border-color:rgba(26,26,26,0.1);color:#1a1a1a">
              <span class="w-4 h-px mt-3 flex-shrink-0" style="background:#b5936b" aria-hidden="true"></span>
              <span>{fr(s)}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {integration.colonnes.map((c) => (
          <article class="bg-[#f7f5f2] border-l-2 p-7 md:p-9" style="border-left-color:#b5936b">
            <h3 class="hp-serif font-light leading-tight mb-4" style="font-size:clamp(1.4rem,2.2vw,1.8rem);color:#1a1a1a">{c.titre}</h3>
            <p class="hp-sans text-sm leading-[1.7] mb-5" style="color:rgba(26,26,26,0.65)">{fr(c.intro)}</p>
            <ul class="space-y-2">
              {c.points.map((pt) => (
                <li class="hp-sans text-sm leading-[1.6] flex gap-3" style="color:#1a1a1a">
                  <span class="w-3 h-px mt-[0.7em] flex-shrink-0" style="background:#b5936b" aria-hidden="true"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="flex flex-col lg:flex-row lg:items-baseline gap-4 lg:gap-8 mb-8">
        <p class="hp-sans text-xs uppercase tracking-[0.3em] flex-shrink-0" style="color:#b5936b">{integration.prestationsTitre}</p>
        <ul class="flex flex-wrap gap-2">
          {integration.prestations.map((x) => (
            <li class="hp-sans text-sm px-4 py-2 border" style="border-color:rgba(26,26,26,0.12);color:#1a1a1a">{x}</li>
          ))}
        </ul>
      </div>
      <p class="hp-sans text-base leading-[1.8] max-w-3xl" style="color:rgba(26,26,26,0.7)">{integration.conclusion}</p>
    </div>
  </section>

  <!-- 5. COORDINATION -->
  <section style="background:#0d0d0d" class="py-16 md:py-28 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-12 lg:gap-16 lg:items-center">
      <div>
        <h2 class="hp-serif font-light leading-tight mb-8" style="font-size:clamp(1.9rem,3.8vw,3rem);color:#f7f5f2">{coordination.h2}</h2>
        {coordination.paragraphes.map((p, i) => (
          <p class={`hp-sans leading-[1.8] mb-4 ${i === 2 ? 'text-base md:text-lg' : 'text-base'}`} style={`color:${i === 2 ? '#f7f5f2' : 'rgba(247,245,242,0.65)'}`}>{p}</p>
        ))}
      </div>
      <!-- Schéma de coordination -->
      <div class="flex flex-col items-center text-center" role="img" aria-label={`${coordination.schema.projet}, puis ${coordination.schema.janus}, puis : ${coordination.schema.expertises.join(', ')}`}>
        <div class="hp-sans text-xs uppercase tracking-[0.3em] px-8 py-4 border" style="border-color:rgba(247,245,242,0.25);color:#f7f5f2">{coordination.schema.projet}</div>
        <span class="w-px h-10" style="background:#b5936b" aria-hidden="true"></span>
        <div class="hp-serif text-2xl md:text-3xl font-light px-8 py-5 w-full max-w-md" style="background:#b5936b;color:#0d0d0d">{coordination.schema.janus}</div>
        <span class="w-px h-10" style="background:#b5936b" aria-hidden="true"></span>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2 w-full">
          {coordination.schema.expertises.map((x) => (
            <li class="hp-sans text-xs md:text-sm px-3 py-4 border" style="border-color:rgba(201,168,76,0.4);color:rgba(247,245,242,0.85)">{x}</li>
          ))}
        </ul>
        <p class="hp-serif italic text-lg md:text-xl leading-snug mt-10" style="color:#c9a84c">{coordination.conclusion}</p>
      </div>
    </div>
  </section>

  <!-- 6. CAS RÉEL -->
  <section style="background:#f7f5f2" class="py-16 md:py-28 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-10 lg:gap-16">
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">{cas.surtitre}</p>
        <h2 class="hp-serif font-light leading-tight mb-8" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{fr(cas.h2)}</h2>
        <a href={cas.cta.href} data-track="cta_principal" data-track-position="cas" class="hp-sans hp-link inline-block text-xs uppercase tracking-widest border-b py-2" style="border-color:#b5936b;color:#1a1a1a">{fr(cas.cta.label)}</a>
      </div>
      <div class="bg-white border-t-2 p-7 md:p-10" style="border-top-color:#b5936b">
        <dl>
          {cas.lignes.map((l) => (
            <div class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-1 sm:gap-6 py-4 border-b" style="border-color:rgba(26,26,26,0.08)">
              <dt class="hp-sans text-[11px] uppercase tracking-[0.2em]" style="color:#b5936b">{l.label}</dt>
              <dd class="hp-sans text-base leading-[1.6]" style="color:#1a1a1a">{fr(l.valeur)}</dd>
            </div>
          ))}
        </dl>
        <p class="hp-sans text-sm leading-[1.7] mt-6" style="color:rgba(26,26,26,0.55)">{cas.confidentialite}</p>
      </div>
    </div>
  </section>

  <!-- 7. AUTRES SITUATIONS -->
  <section class="bg-white py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="hp-serif font-light leading-tight mb-10 md:mb-12" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{autres.h2}</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        {autres.cartes.map((c) => (
          <li>
            <a href={c.href} class="hp-card flex flex-col h-full border p-7 bg-white border-[#1a1a1a]/10">
              <p class="hp-serif text-xl md:text-2xl font-light leading-snug mb-6" style="color:#1a1a1a">… {c.texte}</p>
              <span class="hp-arrow hp-sans text-sm mt-auto transition-colors" style="color:rgba(26,26,26,0.3)" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a href={autres.lien.href} class="hp-sans hp-link inline-block text-xs uppercase tracking-widest border-b py-2" style="border-color:#b5936b;color:#1a1a1a">{fr(autres.lien.label)}</a>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section style="background:#1a1a1a" class="py-24 md:py-32 px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="hp-serif text-3xl md:text-5xl font-light mb-8 leading-tight" style="color:#f7f5f2">{fr(ctaFinal.h2)}</h2>
      {ctaFinal.paragraphes.map((p) => (
        <p class="hp-sans text-base mb-3 max-w-lg mx-auto leading-[1.8]" style="color:rgba(247,245,242,0.7)">{p}</p>
      ))}
      <div class="flex flex-col items-center gap-6 mt-10">
        <a href={ctaFinal.cta.href} data-track="cta_principal" data-track-position="final" class="hp-sans inline-block px-10 md:px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">
          {fr(ctaFinal.cta.label)}
        </a>
        <a href={ctaFinal.telephone.href} data-track="clic_telephone" data-track-position="final" class="hp-sans hp-link text-sm" style="color:rgba(247,245,242,0.75)">
          <span style="color:#c9a84c" aria-hidden="true">→</span> {ctaFinal.telephone.label}
        </a>
      </div>
    </div>
  </section>

</Layout>
