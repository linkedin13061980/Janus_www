---
// Page pilier de l'expertise France–Pologne (et page d'atterrissage Google Ads).
// Contenu : /src/content/fr/pologne.json — page en français uniquement.
// Sélecteur de langue : EN/PL renvoient vers /pologne-investir (cf. src/i18n/routes.ts) ; aucune balise hreflang ;
// la canonical est la page elle-même, sans barre finale.
import Layout from '../../layouts/Layout.astro';
import Flag from '../../components/ui/Flag.astro';
import Tracking from '../../components/ui/Tracking.astro';
import ScenarioTimeline from '../../components/ui/ScenarioTimeline.astro';
import p from '../../content/fr/pologne.json';

// Espace insécable avant « ? » et « France–Pologne » insécable (le tiret ne doit pas couper la ligne).
// Données structurées FAQ : reprend exactement les questions/réponses publiées sur la page.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
const fr = (s: string) => s.replace(/ ([?;:!])/g, '\u00A0$1').replace(/France–Pologne/g, 'France\u2060–\u2060Pologne').replace(/ →/g, '\u00A0→');

// Point de bascule : besoins répartis en ellipse autour de JANUS (desktop uniquement ; liste simple sur mobile).
const besoins = p.bascule.besoins.map((b, i, a) => {
  const t = -Math.PI / 2 + (i * 2 * Math.PI) / a.length;
  return { label: b, x: +(50 + 40 * Math.cos(t)).toFixed(2), y: +(50 + 40 * Math.sin(t)).toFixed(2) };
});
---

<Layout
  title={p.meta.title}
  description={p.meta.description}
  locale="fr"
  currentPath="/pologne"
  canonical="https://agence-janus.fr/fr/pologne"
  alternates={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .fp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .fp-sans { font-family: 'DM Sans', system-ui, sans-serif; }
    .fp a { text-decoration: none; }
    .fp-link { transition: opacity .2s ease; }
    .fp-link:hover { opacity: .7; }
    .fp-card { transition: border-color .2s ease; }
    .fp-card:hover { border-color: rgba(181,147,107,.7) !important; }
    .fp details > summary { list-style: none; cursor: pointer; }
    .fp details > summary::-webkit-details-marker { display: none; }
    .fp details[open] .fp-plus { transform: rotate(45deg); }
    .fp-plus { transition: transform .2s ease; }
    .fp-orbit { position: relative; }
    .fp-orbit-lines { display: none; }
    @media (min-width: 768px) {
      .fp-orbit { height: 440px; }
      .fp-orbit-lines { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
      .fp-orbit-center { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
      .fp-orbit-item { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); white-space: nowrap; }
    }
    .fp-anim .fp-orbit-item, .fp-anim .fp-orbit-lines { opacity: 0; transition: opacity .8s ease; }
    .fp-anim .fp-orbit-item { transition-delay: calc(var(--i) * 70ms); }
    .fp-anim.is-on .fp-orbit-item, .fp-anim.is-on .fp-orbit-lines { opacity: 1; }
    @media (prefers-reduced-motion: reduce) {
      .fp-anim .fp-orbit-item, .fp-anim .fp-orbit-lines { opacity: 1; transition: none; }
    }
  </style>

  <div class="fp">
    <!-- HERO -->
    <section style="background:#1a1a1a" class="px-6 pt-14 pb-16 md:pt-20 md:pb-24">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-3 mb-7">
          <Flag code="fr" class="w-8 h-5" />
          <Flag code="pl" class="w-8 h-5" />
          <p class="fp-sans text-[11px] md:text-xs uppercase tracking-[0.3em]" style="color:#c9a84c">{p.hero.surtitre}</p>
        </div>
        <h1 class="fp-serif font-light leading-[1.05] mb-7 max-w-4xl" style="font-size:clamp(2.4rem,5.5vw,4.25rem);color:#f7f5f2">{fr(p.hero.h1)}</h1>
        <p class="fp-sans text-base md:text-lg max-w-2xl leading-[1.75] mb-10" style="color:rgba(247,245,242,0.8)">{p.hero.accroche}</p>
        <a href={p.hero.cta.href} data-track="cta_principal" data-track-position="hero" class="fp-sans inline-block text-center px-8 sm:px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">{fr(p.hero.cta.label)}</a>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-10 pt-8 border-t" style="border-color:rgba(247,245,242,0.12)">
          {p.hero.reassurance.map((r) => (
            <li class="fp-sans text-xs uppercase tracking-[0.2em] flex items-center gap-2" style="color:rgba(247,245,242,0.65)">
              <span class="inline-block w-1.5 h-1.5" style="background:#c9a84c" aria-hidden="true"></span>{r}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- RELATIONS + INTERVENTIONS -->
    <section id="interventions" class="bg-white px-6 py-16 md:py-24 scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <h2 class="fp-serif font-light leading-tight mb-5 max-w-3xl" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{fr(p.relations.h2)}</h2>
        <p class="fp-sans text-base leading-[1.8] mb-10 max-w-2xl" style="color:rgba(26,26,26,0.7)">{p.relations.intro}</p>

        <h3 class="fp-sans text-xs font-medium uppercase tracking-[0.25em] mb-4" style="color:#b5936b">{p.relations.situationsTitre}</h3>
        <ul class="flex flex-wrap gap-3 mb-10">
          {p.relations.situations.map((s) => (
            <li class="fp-sans text-sm border px-4 py-2.5" style="border-color:rgba(26,26,26,0.14);color:#1a1a1a;background:#f7f5f2">{s}</li>
          ))}
        </ul>

        <h3 class="fp-sans text-xs font-medium uppercase tracking-[0.25em] mb-4" style="color:#b5936b">{p.relations.interventionsTitre}</h3>
        <ul class="flex flex-wrap gap-3">
          {p.relations.interventions.map((it) => (
            <li class="fp-sans text-sm border px-4 py-2.5" style="border-color:rgba(181,147,107,0.45);color:#1a1a1a">{it}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SCÉNARIO -->
    <section id="scenario" style="background:#f7f5f2" class="px-6 py-16 md:py-24 scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl mb-12 md:mb-16">
          <p class="fp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-5" style="color:#8a6d4b">{p.scenario.label}</p>
          <h2 class="fp-serif font-light leading-[1.1] mb-7" style="font-size:clamp(2rem,4vw,3.25rem);color:#1a1a1a">{fr(p.scenario.h2)}</h2>
          {p.scenario.intro.map((t) => (
            <p class="fp-sans text-base leading-[1.8] mb-3" style="color:rgba(26,26,26,0.72)">{fr(t)}</p>
          ))}
          <p class="fp-sans text-xs italic mt-5" style="color:rgba(26,26,26,0.5)">{p.scenario.mention}</p>
        </div>
        <ScenarioTimeline s={p.scenario} />
      </div>
    </section>

    <!-- POINT DE BASCULE -->
    <section style="background:#0d0d0d" class="px-6 py-16 md:py-24">
      <div class="max-w-6xl mx-auto">
        <h2 class="fp-serif font-light leading-tight text-center mb-10 md:mb-6" style="font-size:clamp(2rem,4vw,3.25rem);color:#f7f5f2">{fr(p.bascule.h2)}</h2>

        <div class="fp-orbit" data-fp-reveal>
          <svg class="fp-orbit-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {besoins.map((b) => (
              <line x1="50" y1="50" x2={b.x} y2={b.y} stroke="rgba(201,168,76,0.28)" stroke-width="1" vector-effect="non-scaling-stroke" />
            ))}
          </svg>
          <p class="fp-orbit-center fp-serif text-center mx-auto mb-6 md:mb-0 flex items-center justify-center rounded-full" style="width:120px;height:120px;background:#0d0d0d;border:1px solid #c9a84c;color:#c9a84c;font-size:1.6rem;letter-spacing:.12em">{p.bascule.centre}</p>
          <ul class="flex flex-wrap justify-center gap-2 md:block">
            {besoins.map((b, i) => (
              <li class="fp-orbit-item fp-sans text-xs md:text-[13px] px-3 py-2 border" style={`--x:${b.x}%;--y:${b.y}%;--i:${i};border-color:rgba(247,245,242,0.2);color:rgba(247,245,242,0.88);background:#0d0d0d`}>{b.label}</li>
            ))}
          </ul>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-12 md:mt-10">
          <div class="border p-7" style="border-color:rgba(247,245,242,0.14)">
            <h3 class="fp-sans text-xs font-medium uppercase tracking-[0.22em] mb-4" style="color:rgba(247,245,242,0.55)">{p.bascule.sans.titre}</h3>
            <p class="fp-sans text-sm md:text-base leading-[1.9]" style="color:rgba(247,245,242,0.75)">
              {p.bascule.sans.chaine.map((c, i) => (
                <>{i > 0 && <span style="color:rgba(247,245,242,0.35)" aria-hidden="true">{' → '}</span>}<span class="whitespace-nowrap">{c}</span></>
              ))}
            </p>
          </div>
          <div class="border-t-2 p-7" style="border-top-color:#c9a84c;background:#1a1a1a">
            <h3 class="fp-sans text-xs font-medium uppercase tracking-[0.22em] mb-4" style="color:#c9a84c">{p.bascule.avec.titre}</h3>
            <p class="fp-sans text-sm md:text-base leading-[1.75]" style="color:rgba(247,245,242,0.88)">{p.bascule.avec.texte}</p>
          </div>
        </div>

        <p class="fp-serif italic font-light text-center max-w-3xl mx-auto mt-12 md:mt-16 leading-snug" style="font-size:clamp(1.4rem,2.8vw,2.1rem);color:#f7f5f2">{fr(p.bascule.phrase)}</p>
      </div>
    </section>

    <!-- COORDINATION -->
    <section class="bg-white px-6 py-16 md:py-24">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="fp-serif font-light leading-tight mb-6" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{fr(p.coordination.h2)}</h2>
          <p class="fp-sans text-base leading-[1.8]" style="color:rgba(26,26,26,0.72)">{fr(p.coordination.texte)}</p>
          <div class="flex flex-col items-start gap-5 mt-8">
            <a href={p.coordination.cta.href} data-track="cta_principal" data-track-position="coordination" class="fp-sans inline-block text-center px-8 sm:px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">{fr(p.coordination.cta.label)}</a>
            <a href={p.coordination.lienSecondaire.href} class="fp-sans fp-link text-sm leading-relaxed border-b pb-1" style="border-color:rgba(181,147,107,0.6);color:#1a1a1a">{fr(p.coordination.lienSecondaire.label)}</a>
          </div>
        </div>

        <div class="flex flex-col items-center" aria-hidden="true">
          <p class="fp-sans text-xs uppercase tracking-[0.2em] border px-5 py-3" style="border-color:rgba(26,26,26,0.2);color:#1a1a1a">{p.coordination.schema.haut}</p>
          <span class="block w-px h-8" style="background:rgba(26,26,26,0.25)"></span>
          <p class="fp-serif flex items-center justify-center rounded-full" style="width:96px;height:96px;border:1px solid #c9a84c;color:#8a6d4b;font-size:1.35rem;letter-spacing:.12em;background:#f7f5f2">{p.coordination.schema.centre}</p>
          <span class="block w-px h-8" style="background:#c9a84c"></span>
          <ul class="flex flex-wrap justify-center gap-2 pt-4 border-t w-full max-w-md" style="border-color:#c9a84c">
            {p.coordination.schema.domaines.map((d) => (
              <li class="fp-sans text-xs md:text-sm px-3 py-2" style="background:#f7f5f2;color:#1a1a1a">{d}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- CAS -->
    <section style="background:#f7f5f2" class="px-6 py-16 md:py-24">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <h2 class="fp-serif font-light leading-tight mb-3" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{fr(p.cas.h2)}</h2>
            <p class="fp-sans text-sm md:text-base leading-[1.75]" style="color:rgba(26,26,26,0.68)">{p.cas.intro}</p>
          </div>
          {/* Lien vers les cas clients masqué tant que leur contenu n'est pas validé */}
          {p.cas.lien && (
            <a href={p.cas.lien.href} class="fp-sans fp-link self-start md:self-auto text-xs uppercase tracking-widest border-b py-2 flex-shrink-0" style="border-color:#b5936b;color:#1a1a1a">{p.cas.lien.label}</a>
          )}
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {p.cas.items.map((c) => (
            <li class="border-t-2 px-7 py-6" style="border-top-color:#b5936b;background:#fff">
              <h3 class="fp-sans text-[11px] uppercase tracking-[0.2em] mb-3" style="color:#8a6d4b">{c.secteur}</h3>
              <p class="fp-serif text-lg md:text-xl font-light leading-snug" style="color:#1a1a1a">{c.texte}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- EXPÉRIENCE -->
    <section style="background:#1a1a1a" class="px-6 py-16 md:py-24">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-10 lg:gap-16">
        <div>
          <h2 class="fp-serif font-light leading-tight mb-6" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#f7f5f2">{fr(p.experience.h2)}</h2>
          <p class="fp-sans text-base leading-[1.8] mb-8" style="color:rgba(247,245,242,0.78)">{p.experience.texte}</p>
          <a href={p.experience.lien.href} class="fp-sans fp-link text-xs uppercase tracking-widest border-b py-2" style="border-color:#c9a84c;color:#f7f5f2">{p.experience.lien.label}</a>
        </div>
        <ul class="self-center border-t" style="border-color:rgba(181,147,107,0.3)">
          {p.experience.points.map((pt) => (
            <li class="fp-sans text-sm md:text-base flex items-start gap-4 py-4 border-b" style="border-color:rgba(181,147,107,0.3);color:rgba(247,245,242,0.9)">
              <span class="inline-block w-1.5 h-1.5 mt-2 flex-shrink-0" style="background:#c9a84c" aria-hidden="true"></span>{pt}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PAGES POLOGNE -->
    <section style="background:#f7f5f2" class="px-6 py-16 md:py-24">
      <div class="max-w-6xl mx-auto">
        <h2 class="fp-serif font-light leading-tight mb-10" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{p.pologne.h2}</h2>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {p.pologne.items.map((l) => (
            <li>
              <a href={l.href} class="fp-card flex flex-col h-full bg-white border p-7" style="border-color:rgba(26,26,26,0.1)">
                <h3 class="fp-serif text-xl md:text-2xl font-light mb-2" style="color:#1a1a1a">{l.titre}</h3>
                <p class="fp-sans text-sm leading-[1.7] mb-5" style="color:rgba(26,26,26,0.68)">{l.texte}</p>
                <span class="fp-sans mt-auto text-sm" style="color:#b5936b" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- INTERNATIONAL -->
    <section class="bg-white px-6 py-14 md:py-16 border-b" style="border-color:rgba(26,26,26,0.08)">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="fp-serif text-2xl md:text-3xl font-light leading-tight mb-3" style="color:#1a1a1a">{p.international.h2}</h2>
          <p class="fp-sans text-sm md:text-base leading-[1.75]" style="color:rgba(26,26,26,0.68)">{p.international.texte}</p>
        </div>
        <a href={p.international.lien.href} class="fp-sans fp-link self-start md:self-auto text-xs uppercase tracking-widest border-b py-2 flex-shrink-0" style="border-color:#b5936b;color:#1a1a1a">{p.international.lien.label}</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white px-6 py-16 md:py-24">
      <div class="max-w-3xl mx-auto">
        <h2 class="fp-serif font-light leading-tight mb-8" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">{p.faq.h2}</h2>
        <div class="border-t" style="border-color:rgba(26,26,26,0.12)">
          {p.faq.items.map((f) => (
            <details class="border-b py-5" style="border-color:rgba(26,26,26,0.12)">
              <summary class="flex items-start justify-between gap-6">
                <h3 class="fp-sans text-base md:text-lg font-medium leading-snug" style="color:#1a1a1a">{fr(f.q)}</h3>
                <span class="fp-plus fp-sans text-xl leading-none flex-shrink-0" style="color:#b5936b" aria-hidden="true">+</span>
              </summary>
              <p class="fp-sans text-sm md:text-base leading-[1.8] mt-3 pr-8" style="color:rgba(26,26,26,0.72)">{f.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section style="background:#1a1a1a" class="px-6 py-20 md:py-28 text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="fp-serif text-4xl md:text-5xl font-light leading-tight mb-5" style="color:#f7f5f2">{fr(p.ctaFinal.h2)}</h2>
        <p class="fp-sans text-base leading-[1.8] mb-10" style="color:rgba(247,245,242,0.75)">{p.ctaFinal.texte}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8">
          <a href={p.ctaFinal.cta.href} data-track="cta_principal" data-track-position="final" class="fp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">{p.ctaFinal.cta.label}</a>
          <a href={p.ctaFinal.telephone.href} data-track="clic_telephone" data-track-position="final" class="fp-sans fp-link text-sm tracking-wider border-b py-1" style="border-color:rgba(247,245,242,0.35);color:#f7f5f2">{p.ctaFinal.telephone.label}</a>
        </div>
      </div>
    </section>
  </div>

  <Tracking />
</Layout>

<script>
  // Apparition sobre des besoins autour de JANUS ; rien n'est masqué sans JS ou avec prefers-reduced-motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -20% 0px' });
    document.querySelectorAll('[data-fp-reveal]').forEach((el) => { el.classList.add('fp-anim'); io.observe(el); });
  }
</script>
