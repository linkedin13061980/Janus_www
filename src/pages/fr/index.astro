---
// Homepage FR : explique le modèle JANUS (un projet, plusieurs besoins, un seul interlocuteur qui garde le contexte).
// Lecture rapide : situation du client → intervention de JANUS → action. Situations : boutons + panneaux ;
// contenu dans le HTML initial (affiché sans JavaScript), une seule situation active, aucune au chargement.
// Contenu : /src/content/fr/accueil.json.
import Layout from '../../layouts/Layout.astro';
import Tracking from '../../components/ui/Tracking.astro';
import content from '../../content/fr/accueil.json';

const locale = 'fr';
const currentPath = '/';

// Typographie française : espace insécable avant « ? ; : ! » et « → », « France–Pologne » / « Allemagne–Pologne » insécables.
const num = (i: number) => String(i + 1).padStart(2, '0');
const fr = (s: string) => s.replace(/ ([?;:!])/g, ' $1').replace(/(France|Allemagne)–Pologne/g, '$1⁠–⁠Pologne').replace(/ →/g, ' →');

const { hero, situations, message, methode, langues, pologne, preuves, pourQui, ctaFinal } = content;

// Données structurées : uniquement des informations publiées sur le site (homepage, mentions légales, contact).
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'JANUS',
  legalName: 'MICH',
  url: 'https://agence-janus.fr/fr/',
  logo: 'https://agence-janus.fr/favicon.png',
  image: 'https://agence-janus.fr/og-image.jpg',
  description: content.meta.description,
  telephone: '+33 9 67 05 68 31',
  email: 'contact@agence-janus.fr',
  foundingDate: '2021',
  address: { '@type': 'PostalAddress', streetAddress: '20 ter rue Julien', postalCode: '69003', addressLocality: 'Lyon', addressCountry: 'FR' },
  founder: { '@type': 'Person', name: 'Agata Mich' },
  knowsLanguage: ['fr', 'en', 'pl', 'de', 'es', 'it'],
};

// Visuel du hero : panoramique 2000×744 (ratio 2,69:1), affiché en ratio natif sur toute la largeur, sans recadrage.
// Versions web AVIF/WebP dans public/images/hero/. Image décorative (alt vide) : logo et signature intégrés, contenu essentiel en HTML.
const heroWidths = [640, 960, 1440, 2000];
const heroSrcset = (ext: string) => heroWidths.map((w) => `/images/hero/janus-hero-${w}.${ext} ${w}w`).join(', ');
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  currentPath={currentPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    .hp-balance { text-wrap: balance; }
    .hp a { text-decoration: none; }
    .hp details > summary { list-style: none; cursor: pointer; }
    .hp details > summary::-webkit-details-marker { display: none; }
    .hp details[open] .hp-plus { transform: rotate(45deg); }
    .hp-plus { transition: transform .2s ease; }
    /* Situations. Mobile/tablette : cartes empilées, la carte choisie s'agrandit sur place.
       Desktop (≥ 1024 px) : sélection à gauche, grand panneau associé à droite (hauteur stable). */
    .hp-sits-grid { display: grid; gap: 12px; }
    .hp-sit { background: #fff; border: 1px solid rgba(26,26,26,.08); transition: background-color .25s ease, border-color .25s ease, transform .25s ease; }
    .hp-sit-h { margin: 0; font: inherit; }
    .hp-sit-btn { appearance: none; border: 0; background: none; margin: 0; font: inherit; color: inherit; text-align: left; cursor: pointer; width: 100%;
      display: grid; grid-template-columns: 2.25rem minmax(0,1fr) auto; grid-template-areas: "num cat fl" "num titre fl"; column-gap: 12px; row-gap: 4px; align-items: start; padding: 20px; }
    .hp-sit-btn:focus-visible { outline: 2px solid #b5936b; outline-offset: 3px; }
    .hp-sit-num { grid-area: num; font-weight: 300; font-size: 1.6rem; line-height: 1; color: #b5936b; transition: color .25s; }
    .hp-sit-cat { grid-area: cat; font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: #8a6d4b; transition: color .25s; }
    .hp-sit-titre { grid-area: titre; font-weight: 400; font-size: 1.3rem; line-height: 1.25; color: #1a1a1a; transition: color .25s; }
    .hp-sit-fleche { grid-area: fl; align-self: center; color: #b5936b; font-size: 1.1rem; transition: transform .25s ease, color .25s; }
    .hp-sit.is-active { background: #1a1a1a; border-color: #1a1a1a; }
    .hp-sit.is-active .hp-sit-num, .hp-sit.is-active .hp-sit-cat { color: #c9a84c; }
    .hp-sit.is-active .hp-sit-titre { color: #f7f5f2; }
    .hp-sit.is-active .hp-sit-fleche { transform: rotate(90deg); color: #c9a84c; }
    .hp-sit-pad { padding: 0 20px 24px 68px; display: grid; gap: 20px; font-size: 15px; line-height: 1.6; color: rgba(26,26,26,.8); }
    .hp-sit.is-active .hp-sit-pad { color: rgba(247,245,242,.82); }
    .hp-sit-label { font-size: 11px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: #8a6d4b; margin: 0 0 8px; }
    .hp-sit.is-active .hp-sit-label { color: #c9a84c; }
    .hp-sit-enjeu { margin: 0; }
    .hp-sit-liste { list-style: none; margin: 0 0 20px; padding: 0; line-height: 1.5; }
    .hp-sit-liste li { position: relative; padding-left: 1.5rem; }
    .hp-sit-liste li + li { margin-top: 6px; }
    .hp-sit-liste li::before { content: "—"; position: absolute; left: 0; color: #b5936b; }
    .hp-sit-cta { display: inline-block; font-size: 14px; font-weight: 500; color: #1a1a1a; border-bottom: 1px solid #b5936b; padding-bottom: 4px; transition: opacity .2s; }
    .hp-sit.is-active .hp-sit-cta { color: #f7f5f2; }
    .hp-sit-cta:hover { opacity: .75; }
    .hp-sit-cta:focus-visible { outline: 2px solid #c9a84c; outline-offset: 3px; }
    .hp-sits-vide { display: none; }
    .hp-sits.js .hp-sit-panel { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows .3s ease, visibility 0s linear .3s; }
    .hp-sits.js .hp-sit-panel-in { overflow: hidden; min-height: 0; }
    .hp-sits.js .hp-sit-pad { opacity: 0; transition: opacity .2s ease; }
    .hp-sits.js .hp-sit.is-active .hp-sit-panel { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows .3s ease, visibility 0s; }
    .hp-sits.js .hp-sit.is-active .hp-sit-pad { opacity: 1; transition: opacity .25s ease .1s; }
    @media (hover: hover) {
      .hp-sit:not(.is-active):hover { border-color: rgba(181,147,107,.55); background: #fffdf9; transform: translateY(-1px); }
      .hp-sit:not(.is-active):hover .hp-sit-fleche { transform: translateX(3px); }
    }
    @media (min-width: 1024px) {
      .hp-sits.js .hp-sits-grid { grid-template-columns: minmax(0,5fr) minmax(0,7fr); grid-template-rows: repeat(5, auto) 1fr; column-gap: 0; row-gap: 10px; }
      .hp-sits.js .hp-sit { display: contents; }
      .hp-sits.js .hp-sit-h { grid-column: 1; display: flex; }
      .hp-sits.js .hp-sit:nth-child(1) .hp-sit-h { grid-row: 1; } .hp-sits.js .hp-sit:nth-child(2) .hp-sit-h { grid-row: 2; } .hp-sits.js .hp-sit:nth-child(3) .hp-sit-h { grid-row: 3; }
      .hp-sits.js .hp-sit:nth-child(4) .hp-sit-h { grid-row: 4; } .hp-sits.js .hp-sit:nth-child(5) .hp-sit-h { grid-row: 5; }
      .hp-sits.js .hp-sit-btn { flex: 1 1 auto; width: auto; background: #fff; border: 1px solid rgba(26,26,26,.08); margin-right: 28px; padding: 20px 24px; grid-template-columns: 2.5rem minmax(0,1fr) auto;
        transition: background-color .25s ease, border-color .25s ease, margin .25s ease, transform .25s ease; }
      /* Le bloc actif rejoint le panneau ; sa zone de texte garde la même largeur (pas de changement de hauteur). */
      .hp-sits.js .hp-sit.is-active .hp-sit-btn { background: #1a1a1a; border-color: #1a1a1a; margin-right: 0; padding-right: 52px; }
      .hp-sits.js .hp-sit.is-active .hp-sit-fleche { transform: none; }
      /* Tous les panneaux occupent la même zone : la hauteur reste celle du plus long, sans saut vertical. */
      .hp-sits.js .hp-sit-panel, .hp-sits.js .hp-sits-vide { grid-column: 2; grid-row: 1 / 7; }
      .hp-sits.js .hp-sit-panel { display: block; background: #1a1a1a; opacity: 0; transition: opacity .25s ease, visibility 0s linear .25s; }
      .hp-sits.js .hp-sit.is-active .hp-sit-panel { opacity: 1; transition: opacity .25s ease, visibility 0s; }
      .hp-sits.js .hp-sit-panel-in { overflow: visible; }
      .hp-sits.js .hp-sit-pad { opacity: 1; padding: 48px 56px; gap: 28px; font-size: 16px; color: rgba(247,245,242,.82); }
      .hp-sits.js .hp-sit-label { color: #c9a84c; }
      .hp-sits.js .hp-sit-cta { color: #f7f5f2; }
      .hp-sits.js .hp-sit-enjeu { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.65rem; line-height: 1.35; font-weight: 300; color: #f7f5f2; }
      .hp-sits.js .hp-sits-vide { display: flex; flex-direction: column; justify-content: center; padding: 48px 56px; border: 1px solid rgba(26,26,26,.12); transition: opacity .25s ease; }
      .hp-sits.js.has-active .hp-sits-vide { opacity: 0; visibility: hidden; }
      @media (hover: hover) {
        .hp-sits.js .hp-sit:not(.is-active):hover { transform: none; }
        .hp-sits.js .hp-sit:not(.is-active) .hp-sit-btn:hover { border-color: rgba(181,147,107,.55); background: #fffdf9; transform: translateX(2px); }
      }
    }
    @media (prefers-reduced-motion: reduce) { .hp-sits *, .hp-sits *::before { transition: none !important; animation: none !important; } }
    /* Notre méthode : bande compacte, 3 étapes visibles sans interaction. Desktop : sur une ligne, reliées par des flèches. */
    .hp-met-list { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 18px; }
    .hp-met-item { display: grid; grid-template-columns: 2.5rem minmax(0,1fr); column-gap: 12px; align-items: baseline; }
    .hp-met-num { font-size: 1.6rem; line-height: 1; color: #b5936b; }
    .hp-met-titre { font-weight: 400; font-size: 1.35rem; line-height: 1.2; color: #1a1a1a; margin: 0; }
    .hp-met-txt { grid-column: 2; font-size: 14px; line-height: 1.5; color: rgba(26,26,26,.68); margin: 4px 0 0; }
    .hp-met-fl { display: none; }
    /* Missions : preuve sur fond sombre (faits publiés uniquement). */
    .hp-mis-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    .hp-mis-card { border: 1px solid rgba(247,245,242,.14); padding: 24px 22px; transition: border-color .25s ease; }
    .hp-mis-fig { display: flex; flex-direction: column; gap: 2px; font-weight: 300; color: #c9a84c; line-height: .95; margin: 0 0 18px; }
    .hp-mis-grp { display: flex; align-items: baseline; gap: 12px; white-space: nowrap; }
    .hp-mis-big { font-size: clamp(3rem,6.5vw,5rem); }
    .hp-mis-unit { font-size: clamp(1.15rem,2vw,1.7rem); color: #b5936b; text-transform: uppercase; letter-spacing: .04em; }
    .hp-route { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: #f7f5f2; margin: 0 0 16px; }
    .hp-route-ligne { position: relative; height: 1px; background: rgba(201,168,76,.6); }
    .hp-route-ligne::before, .hp-route-ligne::after { content: ""; position: absolute; top: -3px; width: 7px; height: 7px; border-radius: 50%; background: #c9a84c; }
    .hp-route-ligne::before { left: 0; } .hp-route-ligne::after { right: 0; }
    .hp-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: 12px; line-height: 1.4; }
    .hp-tags li { border: 1px solid rgba(247,245,242,.2); color: rgba(247,245,242,.85); padding: 5px 10px; }
    /* Passerelle France–Pologne. */
    .hp-pass { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border: 1px solid rgba(181,147,107,.55); color: #1a1a1a; transition: background-color .25s ease, border-color .25s ease; }
    .hp-pass-fl { color: #b5936b; font-size: 1.2rem; transition: transform .25s ease; }
    @media (hover: hover) {
      .hp-mis-card:hover { border-color: rgba(201,168,76,.55); }
      .hp-pass:hover { background: #fbf9f6; border-color: #b5936b; }
      .hp-pass:hover .hp-pass-fl { transform: translateX(3px); }
    }
    @media (min-width: 1024px) {
      .hp-met-wrap { display: grid; grid-template-columns: 12rem minmax(0,1fr); gap: 32px; align-items: start; }
      .hp-met-list { margin: 0; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr); gap: 24px; align-items: start; }
      .hp-met-fl { display: block; color: #b5936b; padding-top: 4px; }
      .hp-mis-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; }
      .hp-mis-card { padding: 44px 40px; }
    }
    @media (prefers-reduced-motion: reduce) { .hp-mis-card, .hp-pass, .hp-pass-fl { transition: none !important; } }
  </style>

  <div class="hp">
    <!-- ① HERO : visuel panoramique en ratio natif (aucun recadrage), puis titre, texte et CTA en HTML sous l'image -->
    <section class="hp-hero" style="background:#0d0d0d">
      <picture>
        <source type="image/avif" srcset={heroSrcset('avif')} sizes="100vw" />
        <source type="image/webp" srcset={heroSrcset('webp')} sizes="100vw" />
        <img src="/images/hero/janus-hero-1440.webp" width="2000" height="744" alt="" fetchpriority="high" class="block w-full h-auto" style="aspect-ratio:2000/744" />
      </picture>
      <div class="max-w-6xl mx-auto px-6 pt-7 pb-10 md:pt-10 md:pb-12 lg:grid lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:items-end">
        <div>
          <p class="hp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-4 md:mb-5 flex items-center gap-4" style="color:#c9a84c">
            <span class="hidden sm:inline-block w-10 h-px flex-shrink-0" style="background:#c9a84c" aria-hidden="true"></span>
            <span>{hero.surtitre}</span>
          </p>
          <h1 class="hp-serif hp-balance font-light leading-[1.05] mb-5 lg:mb-0" style="font-size:clamp(2.3rem,4.4vw,3.75rem);color:#f7f5f2">
            {hero.h1}
          </h1>
        </div>
        <div>
          <p class="hp-sans text-[15px] md:text-lg leading-[1.6] mb-7" style="color:rgba(247,245,242,0.82)">
            {fr(hero.sousTexte)}
          </p>
          <a href={hero.cta.href} data-track="cta_principal" data-track-position="hero" class="hp-sans block sm:inline-block text-center px-8 sm:px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">
            {fr(hero.cta.label)}
          </a>
        </div>
      </div>
    </section>

    <!-- ② SITUATIONS : le visiteur choisit la sienne. Contenus dans le HTML initial (lisibles sans JavaScript) ;
         une seule situation active, aucune au chargement. Desktop : sélection à gauche, panneau à droite. -->
    <section id="situations" class="hp-sits px-6 py-14 md:py-20" style="background:#f7f5f2" aria-labelledby="situations-titre">
      <div class="max-w-6xl mx-auto">
        <h2 id="situations-titre" class="hp-serif hp-balance font-light leading-[1.1] mb-8 md:mb-12" style="font-size:clamp(2rem,4vw,3.25rem);color:#1a1a1a">{fr(situations.h2)}</h2>
        <div class="hp-sits-grid">
          {situations.items.map((x, i) => (
            <div class="hp-sit">
              <h3 class="hp-sit-h">
                <button type="button" class="hp-sit-btn" id={`situation-${x.id}`} aria-expanded="false" aria-controls={`situation-${x.id}-contenu`} data-track-open="situation_ouverte" data-track-position={`situation-${num(i)}-${x.id}`}>
                  <span class="hp-sit-num hp-serif" aria-hidden="true">{num(i)}</span>
                  <span class="hp-sit-cat hp-sans">{fr(x.categorie)}</span>
                  <span class="hp-sit-titre hp-serif">{fr(x.titre)}</span>
                  <span class="hp-sit-fleche hp-sans" aria-hidden="true">→</span>
                </button>
              </h3>
              <div class="hp-sit-panel hp-sans" id={`situation-${x.id}-contenu`} role="region" aria-labelledby={`situation-${x.id}`}>
                <div class="hp-sit-panel-in"><div class="hp-sit-pad">
                  <div>
                    <p class="hp-sit-label">{situations.labels.enjeu}</p>
                    <p class="hp-sit-enjeu">{fr(x.enjeu)}</p>
                  </div>
                  <div>
                    <p class="hp-sit-label">{situations.labels.intervient}</p>
                    <ul class="hp-sit-liste">{x.interventions.map((v) => <li>{v}</li>)}</ul>
                    <a href={x.cta.href} data-track="cta_principal" data-track-position={`situation-${num(i)}`} class="hp-sit-cta">{fr(x.cta.label)}</a>
                  </div>
                </div></div>
              </div>
            </div>
          ))}
          <div class="hp-sits-vide" aria-hidden="true">
            <p class="hp-serif font-light m-0 mb-3" style="font-size:2rem;line-height:1.2;color:#1a1a1a">{situations.vide.titre}</p>
            <p class="hp-sans m-0 text-sm md:text-base" style="color:rgba(26,26,26,0.65)">{situations.vide.texte}</p>
          </div>
        </div>
      </div>
      <script is:inline>
        (function () {
          // Activation synchrone (pas de saut au chargement). Mesure : situation_ouverte uniquement quand une situation devient active.
          var root = document.getElementById('situations');
          if (!root) return;
          root.classList.add('js');
          var sits = [].slice.call(root.querySelectorAll('.hp-sit'));
          function set(active) {
            sits.forEach(function (el) {
              var on = el === active;
              el.classList.toggle('is-active', on);
              el.querySelector('.hp-sit-btn').setAttribute('aria-expanded', on ? 'true' : 'false');
            });
            root.classList.toggle('has-active', !!active);
          }
          sits.forEach(function (el) {
            var btn = el.querySelector('.hp-sit-btn');
            btn.addEventListener('click', function () {
              if (el.classList.contains('is-active')) { set(null); return; }
              set(el);
              if (typeof window.janusTrack === 'function') {
                window.janusTrack(btn.getAttribute('data-track-open'), {
                  link_text: (btn.querySelector('.hp-sit-titre').textContent || '').trim().slice(0, 80),
                  position: btn.getAttribute('data-track-position'),
                });
              }
            });
          });
          root.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            var a = root.querySelector('.hp-sit.is-active');
            if (!a) return;
            set(null);
            a.querySelector('.hp-sit-btn').focus();
          });
        })();
      </script>
    </section>

    <!-- ③ MESSAGE CENTRAL + périmètre + compétences mobilisées (visibles) -->
    <section style="background:#0d0d0d" class="px-6 py-16 md:py-24 flex items-center">
      <div class="max-w-4xl mx-auto w-full text-center">
        <h2 class="hp-serif hp-balance font-light leading-[1.1] mb-7" style="font-size:clamp(2.5rem,6vw,4.75rem);color:#f7f5f2">
          <span class="block">{message.lignes[0]}</span>
          <span class="block" style="color:#c9a84c">{message.lignes[1]}</span>
        </h2>
        <p class="hp-sans text-base md:text-lg leading-[1.7] max-w-2xl mx-auto mb-4" style="color:rgba(247,245,242,0.8)">{message.texte}</p>
        <p class="hp-sans text-[13px] md:text-sm leading-[1.6] max-w-xl mx-auto mb-10 md:mb-12" style="color:rgba(247,245,242,0.55)">{message.perimetre}</p>

        <div class="max-w-2xl mx-auto border-t pt-6" style="border-color:rgba(247,245,242,0.18)">
          <p class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.22em] mb-3" style="color:#c9a84c">{message.expertises.label}</p>
          <p class="hp-sans text-sm md:text-base leading-[1.9]">
            {message.expertises.items.map((x, i) => (
              <>{i > 0 && <span aria-hidden="true" style="color:#b5936b">{' · '}</span>}<a href={x.href} class="hp-link whitespace-nowrap border-b pb-0.5" style="color:rgba(247,245,242,0.88);border-color:rgba(201,168,76,0.5)">{x.label}</a></>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- ③ bis NOTRE MÉTHODE : bande compacte, 3 étapes visibles (sans interaction) -->
    <section class="bg-white px-6 pt-10 lg:pt-16">
      <div class="max-w-6xl mx-auto pb-10 lg:pb-16 border-b hp-met-wrap" style="border-color:rgba(26,26,26,0.1)">
        <h2 class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] m-0" style="color:#8a6d4b">{methode.h2}</h2>
        <ol class="hp-met-list hp-sans">
          {methode.etapes.map((e, i) => (
            <>
              {i > 0 && <li class="hp-met-fl" aria-hidden="true">→</li>}
              <li class="hp-met-item">
                <span class="hp-met-num hp-serif font-light" aria-hidden="true">{e.numero}</span>
                <h3 class="hp-met-titre hp-serif">{e.titre}</h3>
                <p class="hp-met-txt">{fr(e.texte)}</p>
              </li>
            </>
          ))}
        </ol>
      </div>
    </section>

    <!-- ⑤ MISSIONS : preuve sur fond sombre (missions réelles confirmées uniquement) + parcours d'Agata Mich -->
    <section class="px-6 py-14 lg:py-[88px]" style="background:#1a1a1a">
      <div class="max-w-6xl mx-auto">
        <h2 class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] mb-6 lg:mb-8" style="color:#c9a84c">{preuves.h2}</h2>
        <div class="hp-mis-grid">
          {preuves.missions.map((m) => (
            <article class="hp-mis-card">
              <p class="hp-mis-fig hp-serif">
                {m.chiffres.map((c) => <span class="hp-mis-grp"><span class="hp-mis-big">{c.nombre}</span><span class="hp-mis-unit">{c.unite}</span></span>)}
              </p>
              <p class="hp-route hp-sans"><span>{m.trajet[0]}</span><span class="hp-route-ligne" aria-hidden="true"></span><span>{m.trajet[1]}</span></p>
              <ul class="hp-tags hp-sans">{m.reperes.map((r) => <li>{r}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="mt-6 lg:mt-9 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-2.5 lg:gap-10 items-baseline hp-sans">
          <p class="text-sm leading-[1.65] max-w-2xl m-0" style="color:rgba(247,245,242,0.7)">{preuves.parcours}</p>
          <a href={preuves.lien.href} class="hp-link justify-self-start text-xs uppercase tracking-[0.2em] border-b pb-1" style="color:#f7f5f2;border-color:#b5936b">{fr(preuves.lien.label)}</a>
        </div>
      </div>
    </section>

    <!-- ④ LANGUES DE TRAVAIL + passerelle courte vers /fr/pologne -->
    <section class="bg-white px-6 py-10 lg:py-14">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-14 items-center">
        <div>
          <h2 class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] mb-2.5" style="color:#8a6d4b">{langues.h2}</h2>
          <p class="hp-serif font-light leading-[1.5] mb-2" style="font-size:clamp(1.25rem,2.2vw,1.6rem);color:#1a1a1a">
            {langues.items.map((l, i) => (
              <><span class="whitespace-nowrap">{l.href
                ? <a href={l.href} class="hp-link border-b" style="border-color:rgba(181,147,107,0.5);color:#1a1a1a">{l.nom}</a>
                : <span>{l.nom}</span>}{i < langues.items.length - 1 && <span aria-hidden="true" style="color:#b5936b">{' ·'}</span>}</span>{i < langues.items.length - 1 && ' '}</>
            ))}
          </p>
          <a href={langues.lien.href} class="hp-sans hp-link text-xs uppercase tracking-widest" style="color:#8a6d4b">{fr(langues.lien.label)}</a>
        </div>
        <a href={pologne.href} class="hp-pass">
          <span>
            <span class="hp-sans block text-[11px] font-medium uppercase tracking-[0.22em] mb-1" style="color:#8a6d4b">{fr(pologne.surtitre)}</span>
            <h2 class="hp-serif font-normal m-0" style="font-size:1.3rem;line-height:1.2">{fr(pologne.h2)}</h2>
          </span>
          <span class="hp-pass-fl hp-sans" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ⑥ POUR QUI : une ligne -->
    <section style="background:#f7f5f2" class="px-6 py-8 md:py-10">
      <div class="max-w-6xl mx-auto hp-sans text-sm leading-[1.7] flex flex-col lg:flex-row lg:items-baseline gap-1 lg:gap-6" style="color:rgba(26,26,26,0.72)">
        <p class="text-[11px] uppercase tracking-[0.24em] font-medium lg:flex-shrink-0" style="color:#8a6d4b">{pourQui.titre}</p>
        <p><span style="color:#1a1a1a">{pourQui.public}</span> — {pourQui.directions}</p>
        <p class="lg:ml-auto">{pourQui.zones}</p>
      </div>
    </section>

    <!-- ⑦ CTA FINAL -->
    <section style="background:#1a1a1a" class="px-6 py-16 md:py-28 text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="hp-serif hp-balance text-4xl md:text-5xl font-light leading-tight mb-5" style="color:#f7f5f2">{fr(ctaFinal.h2)}</h2>
        <p class="hp-sans text-base leading-[1.8] mb-10" style="color:rgba(247,245,242,0.75)">{ctaFinal.texte}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8">
          <a href={ctaFinal.cta.href} data-track="cta_principal" data-track-position="final" class="hp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">{fr(ctaFinal.cta.label)}</a>
          <a href={ctaFinal.telephone.href} data-track="clic_telephone" data-track-position="final" class="hp-sans hp-link text-sm tracking-wider border-b py-1" style="border-color:rgba(247,245,242,0.35);color:#f7f5f2">{ctaFinal.telephone.label}</a>
        </div>
      </div>
    </section>
  </div>

  <Tracking />
</Layout>
