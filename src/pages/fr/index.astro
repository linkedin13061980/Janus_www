---
import Layout from '../../layouts/Layout.astro';

const locale = 'fr';
const currentPath = '/';

// /fr/langues ne possède aucune ancre : toutes les cartes pointent vers la page.
const langues = [
  { code: 'gb', nom: 'Anglais',        href: '/fr/langues' },
  { code: 'pl', nom: 'Polonais',       href: '/fr/langues' },
  { code: 'de', nom: 'Allemand',       href: '/fr/langues' },
  { code: 'es', nom: 'Espagnol',       href: '/fr/langues' },
  { code: 'fr', nom: 'Français / FLE', href: '/fr/langues' },
];

const services = [
  { titre: 'Accompagnement international', motsCles: ['Négociation', 'Coordination', 'Interculturel', 'Présence terrain'], href: '/fr/services' },
  { titre: 'Interprétation',               motsCles: ['Réunions', 'Négociations', 'Visites de sites'],                      href: '/fr/services' },
  { titre: 'Traduction',                   motsCles: ['Documents professionnels', 'Commerciaux', 'Stratégiques'],           href: '/fr/services' },
  { titre: 'Formation professionnelle',    motsCles: ['Langues', 'Métiers', 'Communication interculturelle'],               href: '/fr/services' },
];

const cas = [
  { secteur: 'Industrie · Allemagne ↔ Pologne',         resume: '5 jours · 18 techniciens' },
  { secteur: 'M&A · France ↔ Pologne',                  resume: '4 mois d’accompagnement' },
  { secteur: 'Réunions stratégiques · France ↔ Pologne', resume: 'Interprétation & accompagnement' },
];

const reassurance = [
  { titre: 'FR · EN · PL · DE · ES', texte: 'Services multilingues' },
  { titre: 'France & Europe',        texte: 'À distance et sur le terrain' },
  { titre: 'Confidentialité',        texte: 'NDA selon les missions' },
  { titre: 'Qualiopi',               texte: 'Formation professionnelle certifiée' },
];
---

<Layout
  title="JANUS | Services multilingues & accompagnement international B2B"
  description="JANUS accompagne les entreprises à l'international : interprétation, traduction, accompagnement terrain et formation en anglais, polonais, allemand, espagnol et français."
  locale={locale}
  currentPath={currentPath}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-card { transition: border-color .2s ease, box-shadow .2s ease; }
    .hp-card:hover { border-color: rgba(181,147,107,.6); box-shadow: 0 10px 28px rgba(0,0,0,.05); }
    .hp-card:hover .hp-arrow { color: #b5936b; }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    .hp-flag { box-shadow: 0 0 0 1px rgba(26,26,26,.08); }
    a { text-decoration: none !important; }
  </style>

  <!-- ① HERO + ENTRÉE PAR LANGUE -->
  <section style="background:#f7f5f2" class="pt-28 md:pt-28 pb-16 md:pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-4xl">
        <p class="hp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-6" style="color:#b5936b">
          Accompagnement international &amp; services multilingues
        </p>
        <h1 class="hp-serif font-light leading-[1.08] mb-6 md:mb-8" style="font-size:clamp(2.3rem,5vw,3.75rem);color:#1a1a1a">
          Vos échanges internationaux,<br class="hidden md:block" />
          plus simples et plus efficaces.
        </h1>
        <p class="hp-sans text-base md:text-lg max-w-2xl leading-[1.8] mb-8" style="color:rgba(26,26,26,0.65)">
          JANUS accompagne vos projets internationaux, de la préparation des échanges jusqu’à l’intervention sur le terrain.
        </p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
          <a href="/fr/contact" class="hp-sans inline-block text-center px-8 sm:px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
            Parler de votre projet
          </a>
          <a href="/fr/services" class="hp-sans hp-link inline-block text-center py-3 text-xs uppercase tracking-widest border-b" style="border-color:rgba(26,26,26,0.3);color:#1a1a1a">
            Découvrir nos services
          </a>
        </div>
      </div>

      <!-- Entrée par langue -->
      <div class="mt-14 md:mt-12 pt-10 border-t" style="border-color:rgba(26,26,26,0.1)">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 md:gap-8 mb-6">
          <div>
            <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">Votre langue</p>
            <h2 class="hp-serif font-light leading-tight" style="font-size:clamp(1.6rem,3vw,2.25rem);color:#1a1a1a">
              Dans quelle langue travaillez-vous&nbsp;?
            </h2>
          </div>
          <p class="hp-sans text-sm leading-[1.7] md:max-w-xs md:text-right" style="color:rgba(26,26,26,0.6)">
            Accédez directement aux solutions adaptées à vos échanges professionnels.
          </p>
        </div>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {langues.map((l, i) => (
            <li class={i === langues.length - 1 ? 'col-span-2 sm:col-span-1' : ''}>
              <a href={l.href} class="hp-card flex flex-col items-start sm:flex-row sm:items-center gap-3 sm:gap-4 h-full bg-white border border-[#1a1a1a]/10 px-5 py-5 md:py-6">
                <span class="hp-flag block flex-shrink-0 w-9 h-6 overflow-hidden" aria-hidden="true">
                  {l.code === 'gb' && (
                    <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" class="w-full h-full">
                      <clipPath id="uk-s"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
                      <clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath>
                      <g clip-path="url(#uk-s)">
                        <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
                        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
                        <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4"/>
                        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
                        <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
                      </g>
                    </svg>
                  )}
                  {l.code === 'pl' && (
                    <svg viewBox="0 0 3 2" preserveAspectRatio="none" class="w-full h-full"><rect width="3" height="1" fill="#fff"/><rect y="1" width="3" height="1" fill="#DC143C"/></svg>
                  )}
                  {l.code === 'de' && (
                    <svg viewBox="0 0 3 3" preserveAspectRatio="none" class="w-full h-full"><rect width="3" height="1" fill="#000"/><rect y="1" width="3" height="1" fill="#DD0000"/><rect y="2" width="3" height="1" fill="#FFCE00"/></svg>
                  )}
                  {l.code === 'es' && (
                    <svg viewBox="0 0 3 4" preserveAspectRatio="none" class="w-full h-full"><rect width="3" height="4" fill="#AA151B"/><rect y="1" width="3" height="2" fill="#F1BF00"/></svg>
                  )}
                  {l.code === 'fr' && (
                    <svg viewBox="0 0 3 2" preserveAspectRatio="none" class="w-full h-full"><rect width="1" height="2" fill="#002395"/><rect x="1" width="1" height="2" fill="#fff"/><rect x="2" width="1" height="2" fill="#ED2939"/></svg>
                  )}
                </span>
                <span class="hp-serif text-lg md:text-xl font-light leading-tight flex-1 min-w-0" style="color:#1a1a1a">{l.nom}</span>
                <span class="hp-arrow hp-sans text-sm transition-colors hidden sm:inline" style="color:rgba(26,26,26,0.3)" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ② SERVICES -->
  <section class="bg-white py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-12">
        <div>
          <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">Votre besoin</p>
          <h2 class="hp-serif font-light leading-tight" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">
            Comment pouvons-nous vous accompagner&nbsp;?
          </h2>
        </div>
        <a href="/fr/services" class="hp-sans hp-link self-start md:self-auto text-xs uppercase tracking-widest border-b py-2 flex-shrink-0" style="border-color:#b5936b;color:#1a1a1a">
          Découvrir tous nos services →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map((s, i) => (
          <a href={s.href} class="hp-card flex flex-col bg-[#f7f5f2] border border-[#1a1a1a]/5 p-7">
            <p class="hp-serif font-light leading-none mb-5" style="font-size:2rem;color:#b5936b">0{i + 1}</p>
            <h3 class="hp-sans text-sm font-medium uppercase tracking-[0.15em] leading-snug mb-4" style="color:#1a1a1a">{s.titre}</h3>
            <p class="hp-sans text-sm leading-[1.7] mb-5" style="color:rgba(26,26,26,0.6)">{s.motsCles.join(' · ')}</p>
            <span class="hp-arrow hp-sans text-sm mt-auto transition-colors" style="color:rgba(26,26,26,0.3)" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ CAS CONCRETS -->
  <section style="background:#f7f5f2" class="py-14 md:py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-3 mb-8">
        <p class="hp-sans text-xs uppercase tracking-[0.3em]" style="color:#b5936b">Sur le terrain</p>
        <a href="/fr/cas-clients" class="hp-sans hp-link text-xs uppercase tracking-widest border-b py-1 flex-shrink-0" style="border-color:#b5936b;color:#1a1a1a">
          Voir nos cas clients →
        </a>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {cas.map(c => (
          <li class="bg-white border-t-2 px-7 py-6" style="border-top-color:#b5936b">
            <p class="hp-sans text-[11px] uppercase tracking-[0.2em] mb-3" style="color:#b5936b">{c.secteur}</p>
            <p class="hp-serif text-xl md:text-2xl font-light leading-snug" style="color:#1a1a1a">{c.resume}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ④ EXPERTISE FRANCE–POLOGNE -->
  <section class="bg-white py-14 md:py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="bg-[#f7f5f2] border-l-2 p-8 md:p-10 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 md:gap-12 md:items-center" style="border-left-color:#b5936b">
        <div>
          <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">Une expertise particulière</p>
          <h2 class="hp-serif font-light leading-none mb-5" style="font-size:clamp(2rem,4.5vw,3rem);color:#1a1a1a">
            France <span style="color:#b5936b">↔</span> Pologne
          </h2>
          <p class="hp-sans text-sm md:text-base leading-[1.8] max-w-xl" style="color:rgba(26,26,26,0.65)">
            Une expérience particulière des projets franco-polonais : négociation, interprétation, coordination et accompagnement terrain.
          </p>
        </div>
        <a href="/fr/marches/pologne" class="hp-sans inline-block text-center px-8 py-4 text-xs uppercase tracking-widest border hover:bg-[#b5936b] transition-colors" style="border-color:#b5936b;color:#1a1a1a">
          Découvrir notre expertise <span class="whitespace-nowrap">France–Pologne&nbsp;→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ⑦ RÉASSURANCE -->
  <section style="background:#1a1a1a" class="py-14 md:py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10">
        {reassurance.map(r => (
          <li class="text-center">
            <span class="block w-6 h-px mx-auto mb-4" style="background:#b5936b"></span>
            <p class="hp-serif text-xl md:text-2xl font-light mb-2" style="color:#b5936b">{r.titre}</p>
            <p class="hp-sans text-xs leading-relaxed" style="color:rgba(255,255,255,0.6)">{r.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ⑧ CTA FINAL -->
  <section style="background:#f7f5f2" class="py-24 md:py-32 px-6 text-center">
    <div class="max-w-xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-8" style="color:#b5936b">Premier échange confidentiel</p>
      <h2 class="hp-serif text-4xl md:text-5xl font-light mb-6 leading-tight" style="color:#1a1a1a">
        Un projet international&nbsp;?<br/><em class="italic" style="color:#b5936b">Parlons-en.</em>
      </h2>
      <p class="hp-sans text-base mb-12 max-w-md mx-auto leading-[1.8]" style="color:rgba(26,26,26,0.65)">
        Expliquez-nous votre situation, les langues concernées et l’objectif de votre projet. Nous vous répondrons sous 24h.
      </p>
      <a href="/fr/contact" class="hp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
        Parler de votre projet →
      </a>
    </div>
  </section>

</Layout>
