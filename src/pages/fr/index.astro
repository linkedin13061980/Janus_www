---
// Homepage FR : explique le modèle JANUS (un projet, plusieurs besoins, un seul interlocuteur qui garde le contexte).
// Lecture rapide : situation du client → intervention de JANUS → action. Les situations sont repliables (<details>),
// leur contenu reste dans le HTML initial ; une seule ouverte à la fois (attribut name), aucune ouverte au chargement.
// Contenu : /src/content/fr/accueil.json.
import Layout from '../../layouts/Layout.astro';
import Tracking from '../../components/ui/Tracking.astro';
import content from '../../content/fr/accueil.json';

const locale = 'fr';
const currentPath = '/';

// Typographie française : espace insécable avant « ? ; : ! » et « → », « France–Pologne » / « Allemagne–Pologne » insécables.
const num = (i: number) => String(i + 1).padStart(2, '0');
const fr = (s: string) => s.replace(/ ([?;:!])/g, ' $1').replace(/(France|Allemagne)–Pologne/g, '$1⁠–⁠Pologne').replace(/ →/g, ' →');

const { hero, situations, message, methode, langues, pologne, preuves, pourQui, ctaFinal } = content;

// Données structurées : uniquement des informations publiées sur le site (homepage, mentions légales, contact).
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'JANUS',
  legalName: 'MICH',
  url: 'https://agence-janus.fr/fr/',
  logo: 'https://agence-janus.fr/favicon.png',
  image: 'https://agence-janus.fr/og-image.jpg',
  description: content.meta.description,
  telephone: '+33 9 67 05 68 31',
  email: 'contact@agence-janus.fr',
  foundingDate: '2021',
  address: { '@type': 'PostalAddress', streetAddress: '20 ter rue Julien', postalCode: '69003', addressLocality: 'Lyon', addressCountry: 'FR' },
  founder: { '@type': 'Person', name: 'Agata Mich' },
  knowsLanguage: ['fr', 'en', 'pl', 'de', 'es', 'it'],
};

// Visuel du hero : panoramique 2000×744 (ratio 2,69:1), affiché en ratio natif sur toute la largeur, sans recadrage.
// Versions web AVIF/WebP dans public/images/hero/. Image décorative (alt vide) : logo et signature intégrés, contenu essentiel en HTML.
const heroWidths = [640, 960, 1440, 2000];
const heroSrcset = (ext: string) => heroWidths.map((w) => `/images/hero/janus-hero-${w}.${ext} ${w}w`).join(', ');
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  currentPath={currentPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    .hp-balance { text-wrap: balance; }
    .hp a { text-decoration: none; }
    .hp details > summary { list-style: none; cursor: pointer; }
    .hp details > summary::-webkit-details-marker { display: none; }
    .hp details[open] .hp-plus { transform: rotate(45deg); }
    .hp-plus { transition: transform .2s ease; }
    /* Situations : liste verticale repliable. Mobile : contenu en une colonne ; desktop (≥ 768 px) : deux colonnes. */
    .hp-sit summary { display: grid; grid-template-columns: 2.5rem minmax(0,1fr) auto; align-items: center; gap: 1rem; min-height: 64px; padding: 1.1rem 0; }
    .hp-sit summary:focus-visible { outline: 2px solid #b5936b; outline-offset: 4px; }
    .hp-sit-num { font-size: 1.35rem; line-height: 1; color: #b5936b; }
    .hp-sit-titre { font-size: clamp(1.2rem, 2.1vw, 1.6rem); line-height: 1.25; font-weight: 300; color: #1a1a1a; margin: 0; }
    .hp-sit summary:hover .hp-sit-titre { color: #8a6d4b; }
    .hp-sit-corps { display: grid; grid-template-columns: minmax(0,1fr); gap: 1.5rem; padding: 0 0 2rem 3.5rem; }
    .hp-sit-label { font-size: 11px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: #8a6d4b; margin: 0 0 .5rem; }
    .hp-sit-liste { list-style: none; margin: 0 0 1.25rem; padding: 0; }
    .hp-sit-liste li { position: relative; padding-left: 1.6rem; line-height: 1.5; }
    .hp-sit-liste li + li { margin-top: .35rem; }
    .hp-sit-liste li::before { content: "—"; position: absolute; left: 0; color: #b5936b; }
    @media (max-width: 479px) { .hp-sit summary { grid-template-columns: 1.75rem minmax(0,1fr) auto; gap: .75rem; } .hp-sit-corps { padding-left: 2.5rem; } }
    @media (min-width: 768px) { .hp-sit-corps { grid-template-columns: minmax(0,1fr) minmax(0,1.2fr); gap: 3rem; } }
    /* Notre méthode : 3 temps (avant, pendant, dans la durée), visibles sans clic. Mobile : filet vertical ; desktop (≥ 1024 px) : 3 colonnes reliées par un filet fléché. */
    .hp-methode { list-style: none; margin: 0; padding: 0 0 0 20px; position: relative; }
    .hp-methode::before { content: ""; position: absolute; left: 3px; top: 6px; bottom: 6px; width: 1px; background: #c9a84c; }
    .hp-etape + .hp-etape { margin-top: 1.4rem; }
    .hp-repere { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(26,26,26,.5); margin: 0 0 .2rem; }
    .hp-etape-tete { display: flex; align-items: baseline; gap: .7rem; }
    .hp-num { font-size: 1.75rem; line-height: 1; color: #b5936b; }
    .hp-trait { display: none; }
    .hp-etape-titre { font-size: 13px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #1a1a1a; margin: 0; }
    .hp-etape-txt { font-size: .95rem; line-height: 1.5; color: rgba(26,26,26,.7); margin: .3rem 0 0; }
    @media (min-width: 1024px) {
      .hp-methode { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 2.5rem; padding: 0; }
      .hp-methode::before { content: none; }
      .hp-etape + .hp-etape { margin-top: 0; }
      .hp-repere { margin-bottom: .5rem; }
      .hp-etape-tete { flex-wrap: wrap; align-items: center; gap: .9rem; }
      .hp-num { font-size: 2.75rem; }
      .hp-trait { display: block; flex: 1; height: 1px; background: #c9a84c; position: relative; margin-right: -1.6rem; }
      .hp-trait::after { content: ""; position: absolute; right: 0; top: -4px; border: 4.5px solid transparent; border-left: 7px solid #c9a84c; border-right: 0; }
      .hp-etape:last-child .hp-trait { visibility: hidden; margin-right: 0; }
      .hp-etape-titre { flex-basis: 100%; margin-top: .4rem; }
      .hp-etape-txt { margin-top: .5rem; }
    }
  </style>

  <div class="hp">
    <!-- ① HERO : visuel panoramique en ratio natif (aucun recadrage), puis titre, texte et CTA en HTML sous l'image -->
    <section class="hp-hero" style="background:#0d0d0d">
      <picture>
        <source type="image/avif" srcset={heroSrcset('avif')} sizes="100vw" />
        <source type="image/webp" srcset={heroSrcset('webp')} sizes="100vw" />
        <img src="/images/hero/janus-hero-1440.webp" width="2000" height="744" alt="" fetchpriority="high" class="block w-full h-auto" style="aspect-ratio:2000/744" />
      </picture>
      <div class="max-w-6xl mx-auto px-6 pt-7 pb-10 md:pt-10 md:pb-12 lg:grid lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:items-end">
        <div>
          <p class="hp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-4 md:mb-5 flex items-center gap-4" style="color:#c9a84c">
            <span class="hidden sm:inline-block w-10 h-px flex-shrink-0" style="background:#c9a84c" aria-hidden="true"></span>
            <span>{hero.surtitre}</span>
          </p>
          <h1 class="hp-serif hp-balance font-light leading-[1.05] mb-5 lg:mb-0" style="font-size:clamp(2.3rem,4.4vw,3.75rem);color:#f7f5f2">
            {hero.h1}
          </h1>
        </div>
        <div>
          <p class="hp-sans text-[15px] md:text-lg leading-[1.6] mb-7" style="color:rgba(247,245,242,0.82)">
            {fr(hero.sousTexte)}
          </p>
          <a href={hero.cta.href} data-track="cta_principal" data-track-position="hero" class="hp-sans block sm:inline-block text-center px-8 sm:px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">
            {fr(hero.cta.label)}
          </a>
        </div>
      </div>
    </section>

    <!-- ② SITUATIONS : le visiteur choisit la sienne ; contenu présent dans le HTML, une seule ouverte à la fois -->
    <section style="background:#f7f5f2" class="px-6 py-14 md:py-20" aria-labelledby="situations-titre">
      <div class="max-w-5xl mx-auto">
        <h2 id="situations-titre" class="hp-serif hp-balance font-light leading-[1.1] mb-8 md:mb-12" style="font-size:clamp(2rem,4vw,3.25rem);color:#1a1a1a">{fr(situations.h2)}</h2>
        <div class="border-t" style="border-color:rgba(26,26,26,0.15)">
          {situations.items.map((x, i) => (
            <details name="situations" id={`situation-${x.id}`} class="hp-sit border-b" style="border-color:rgba(26,26,26,0.15)">
              <summary data-track="situation_ouverte" data-track-position={`situation-${num(i)}-${x.id}`}>
                <span class="hp-sit-num hp-serif font-light" aria-hidden="true">{num(i)}</span>
                <h3 class="hp-sit-titre hp-serif">{fr(x.titre)}</h3>
                <span class="hp-plus hp-sans text-2xl leading-none" style="color:#b5936b" aria-hidden="true">+</span>
              </summary>
              <div class="hp-sit-corps hp-sans">
                <div>
                  <p class="hp-sit-label">{situations.labels.enjeu}</p>
                  <p class="text-[15px] md:text-base leading-[1.6]" style="color:rgba(26,26,26,0.8)">{fr(x.enjeu)}</p>
                </div>
                <div>
                  <p class="hp-sit-label">{situations.labels.intervient}</p>
                  <ul class="hp-sit-liste text-[15px] md:text-base" style="color:#1a1a1a">
                    {x.interventions.map((v) => <li>{v}</li>)}
                  </ul>
                  <a href={x.cta.href} data-track="cta_principal" data-track-position={`situation-${num(i)}`} class="hp-link text-sm font-medium border-b pb-1" style="border-color:#b5936b;color:#1a1a1a">{fr(x.cta.label)}</a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ③ MESSAGE CENTRAL + périmètre + compétences mobilisées (visibles) -->
    <section style="background:#0d0d0d" class="px-6 py-16 md:py-24 flex items-center">
      <div class="max-w-4xl mx-auto w-full text-center">
        <h2 class="hp-serif hp-balance font-light leading-[1.1] mb-7" style="font-size:clamp(2.5rem,6vw,4.75rem);color:#f7f5f2">
          <span class="block">{message.lignes[0]}</span>
          <span class="block" style="color:#c9a84c">{message.lignes[1]}</span>
        </h2>
        <p class="hp-sans text-base md:text-lg leading-[1.7] max-w-2xl mx-auto mb-4" style="color:rgba(247,245,242,0.8)">{message.texte}</p>
        <p class="hp-sans text-[13px] md:text-sm leading-[1.6] max-w-xl mx-auto mb-10 md:mb-12" style="color:rgba(247,245,242,0.55)">{message.perimetre}</p>

        <div class="max-w-2xl mx-auto border-t pt-6" style="border-color:rgba(247,245,242,0.18)">
          <p class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.22em] mb-3" style="color:#c9a84c">{message.expertises.label}</p>
          <p class="hp-sans text-sm md:text-base leading-[1.9]">
            {message.expertises.items.map((x, i) => (
              <>{i > 0 && <span aria-hidden="true" style="color:#b5936b">{' · '}</span>}<a href={x.href} class="hp-link whitespace-nowrap border-b pb-0.5" style="color:rgba(247,245,242,0.88);border-color:rgba(201,168,76,0.5)">{x.label}</a></>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- ③ bis NOTRE MÉTHODE : comment JANUS travaille (sans liens ni CTA) -->
    <section class="bg-white px-6 pt-12 md:pt-[72px]">
      <div class="max-w-6xl mx-auto pb-12 md:pb-[72px] border-b" style="border-color:rgba(26,26,26,0.1)">
        <h2 class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] mb-6 md:mb-10" style="color:#8a6d4b">{methode.h2}</h2>
        <ol class="hp-methode">
          {methode.etapes.map((e) => (
            <li class="hp-etape">
              <p class="hp-repere hp-sans">{e.repere}</p>
              <div class="hp-etape-tete">
                <span class="hp-num hp-serif font-light" aria-hidden="true">{e.numero}</span>
                <span class="hp-trait" aria-hidden="true"></span>
                <h3 class="hp-etape-titre hp-sans">{e.titre}</h3>
              </div>
              <p class="hp-etape-txt hp-sans">{e.texte}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ④ LANGUES DE TRAVAIL + EXPERTISE FRANCE–POLOGNE -->
    <section class="bg-white px-6 py-14 md:py-20">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
        <div>
          <h2 class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] mb-5" style="color:#8a6d4b">{langues.h2}</h2>
          <p class="hp-serif font-light leading-[1.5] mb-5" style="font-size:clamp(1.4rem,2.4vw,1.75rem);color:#1a1a1a">
            {langues.items.map((l, i) => (
              <>{i > 0 && <span aria-hidden="true" style="color:#b5936b">{' · '}</span>}{l.href
                ? <a href={l.href} class="hp-link whitespace-nowrap border-b" style="border-color:rgba(181,147,107,0.5);color:#1a1a1a">{l.nom}</a>
                : <span class="whitespace-nowrap">{l.nom}</span>}</>
            ))}
          </p>
          <a href={langues.lien.href} class="hp-sans hp-link text-xs uppercase tracking-widest" style="color:#8a6d4b">{fr(langues.lien.label)}</a>
        </div>
        <div class="border-t pt-10 lg:border-t-0 lg:pt-0 lg:border-l lg:pl-16" style="border-color:rgba(181,147,107,0.4)">
          <h2 class="hp-serif hp-balance font-light leading-tight mb-4" style="font-size:clamp(1.6rem,2.8vw,2.1rem);color:#1a1a1a">{fr(pologne.h2)}</h2>
          <p class="hp-sans text-sm md:text-base leading-[1.7] mb-5" style="color:rgba(26,26,26,0.7)">{pologne.texte}</p>
          <a href={pologne.lien.href} class="hp-sans hp-link text-sm font-medium border-b pb-1" style="border-color:#b5936b;color:#1a1a1a">{fr(pologne.lien.label)}</a>
        </div>
      </div>
    </section>

    <!-- ⑤ PREUVES : lecture par chiffres (missions réelles confirmées uniquement) -->
    <section class="bg-white px-6 pb-14 md:pb-24">
      <div class="max-w-6xl mx-auto border-t pt-12 md:pt-16" style="border-color:rgba(26,26,26,0.1)">
        <h2 class="hp-sans text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] mb-8 md:mb-12" style="color:#8a6d4b">{preuves.h2}</h2>
        <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-8 lg:gap-0">
          <div class="lg:pr-14">
            <p class="hp-serif font-light uppercase leading-none mb-4" style="font-size:clamp(4.5rem,10vw,8rem);color:#b5936b">{preuves.principale.chiffre}</p>
            <p class="hp-serif text-xl md:text-2xl leading-snug max-w-lg" style="color:#1a1a1a">{fr(preuves.principale.texte)}</p>
          </div>
          <div class="border-t pt-8 lg:border-t-0 lg:pt-0 lg:border-l lg:pl-14 lg:flex lg:flex-col lg:justify-end" style="border-color:#c9a84c">
            <p class="hp-serif font-light uppercase leading-[1.05] mb-4" style="font-size:clamp(2.1rem,3.8vw,3.1rem);color:#8a6d4b">{preuves.secondaire.chiffre.split(' · ').map((c, i) => (<>{i > 0 && ' · '}<span class="whitespace-nowrap">{c}</span></>))}</p>
            <p class="hp-serif text-lg md:text-xl leading-snug" style="color:#1a1a1a">{fr(preuves.secondaire.texte)}</p>
          </div>
        </div>
        <p class="hp-sans text-sm md:text-base leading-[1.75] max-w-2xl mt-12 md:mt-14 mb-3" style="color:rgba(26,26,26,0.7)">{preuves.parcours}</p>
        <a href={preuves.lien.href} class="hp-sans hp-link text-xs uppercase tracking-widest border-b py-1" style="border-color:#b5936b;color:#1a1a1a">{fr(preuves.lien.label)}</a>
      </div>
    </section>

    <!-- ⑥ POUR QUI : une ligne -->
    <section style="background:#f7f5f2" class="px-6 py-8 md:py-10">
      <div class="max-w-6xl mx-auto hp-sans text-sm leading-[1.7] flex flex-col lg:flex-row lg:items-baseline gap-1 lg:gap-6" style="color:rgba(26,26,26,0.72)">
        <p class="text-[11px] uppercase tracking-[0.24em] font-medium lg:flex-shrink-0" style="color:#8a6d4b">{pourQui.titre}</p>
        <p><span style="color:#1a1a1a">{pourQui.public}</span> — {pourQui.directions}</p>
        <p class="lg:ml-auto">{pourQui.zones}</p>
      </div>
    </section>

    <!-- ⑦ CTA FINAL -->
    <section style="background:#1a1a1a" class="px-6 py-16 md:py-28 text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="hp-serif hp-balance text-4xl md:text-5xl font-light leading-tight mb-5" style="color:#f7f5f2">{fr(ctaFinal.h2)}</h2>
        <p class="hp-sans text-base leading-[1.8] mb-10" style="color:rgba(247,245,242,0.75)">{ctaFinal.texte}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8">
          <a href={ctaFinal.cta.href} data-track="cta_principal" data-track-position="final" class="hp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">{fr(ctaFinal.cta.label)}</a>
          <a href={ctaFinal.telephone.href} data-track="clic_telephone" data-track-position="final" class="hp-sans hp-link text-sm tracking-wider border-b py-1" style="border-color:rgba(247,245,242,0.35);color:#f7f5f2">{ctaFinal.telephone.label}</a>
        </div>
      </div>
    </section>
  </div>

  <Tracking />
</Layout>
