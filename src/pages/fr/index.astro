---
import Layout from '../../layouts/Layout.astro';

const locale = 'fr';
const currentPath = '/';

const situations = [
  {
    n: '01',
    titre: 'Vous négociez avec un partenaire étranger',
    texte: 'Préparation des échanges, accompagnement interculturel, interprétation et présence pendant les négociations pour faciliter la compréhension et sécuriser les échanges.',
  },
  {
    n: '02',
    titre: 'Vos équipes internationales doivent travailler efficacement ensemble',
    texte: 'JANUS facilite les échanges entre collaborateurs, partenaires et fournisseurs lorsque la langue ou les différences culturelles compliquent la collaboration.',
  },
  {
    n: '03',
    titre: 'Vous avez une mission ou un projet à mener sur le terrain',
    texte: 'Coordination, interprétation et accompagnement opérationnel aux côtés de vos équipes, partenaires ou fournisseurs en France et en Europe.',
  },
  {
    n: '04',
    titre: 'Vos collaborateurs doivent gagner en autonomie linguistique',
    texte: 'Des formations professionnelles ciblées sur leur métier et sur les situations réellement rencontrées dans leur travail.',
  },
];

const services = [
  {
    titre: 'Négociation & communication interculturelle',
    texte: 'Préparer les échanges, comprendre les codes culturels et faciliter les négociations avec vos partenaires internationaux.',
    href: '/fr/services',
  },
  {
    titre: 'Interprétation professionnelle',
    texte: 'Interprétation lors de réunions, négociations, visites de sites et échanges professionnels, à distance ou sur le terrain.',
    href: '/fr/services',
  },
  {
    titre: 'Accompagnement terrain',
    texte: 'Présence opérationnelle aux côtés de vos équipes lors de missions, visites, réunions et projets impliquant des partenaires étrangers.',
    href: '/fr/services',
  },
  {
    titre: 'Traduction stratégique',
    texte: 'Traduction de documents et supports professionnels lorsque la précision du message et la compréhension du contexte sont essentielles.',
    href: '/fr/services',
  },
  {
    titre: 'Formation professionnelle',
    texte: 'Formations linguistiques et interculturelles ciblées sur le métier, les objectifs et les situations professionnelles réelles des collaborateurs.',
    href: '/fr/services',
  },
];

const pologneListe = [
  'Négociations et rendez-vous professionnels',
  'Missions et visites sur site',
  'Relations fournisseurs et partenaires',
  'Coordination d’équipes franco-polonaises',
  'Interprétation et traduction professionnelle',
];

const marches = [
  { pays: 'Royaume-Uni', href: '/fr/marches/royaume-uni' },
  { pays: 'Allemagne',   href: '/fr/marches/allemagne' },
  { pays: 'Espagne',     href: '/fr/marches/espagne' },
  { pays: 'Italie',      href: '/fr/marches/italie' },
];

const cas = [
  {
    secteur: 'Industrie · Allemagne ↔ Pologne',
    texte: '5 jours d’accompagnement sur site auprès de 18 techniciens pour faciliter les échanges et la coordination des équipes.',
  },
  {
    secteur: 'Opération M&A · France ↔ Pologne',
    texte: '4 mois d’accompagnement linguistique et interculturel dans le cadre d’une opération transfrontalière.',
  },
  {
    secteur: 'Réunions stratégiques · France ↔ Pologne',
    texte: 'Interprétation et accompagnement à distance lors d’échanges professionnels entre interlocuteurs français et polonais.',
  },
];

const reassurance = [
  { titre: 'FR · PL · DE · EN',  texte: 'Langues de travail' },
  { titre: 'France & Europe',    texte: 'Interventions à distance et sur le terrain' },
  { titre: 'Confidentialité',    texte: 'NDA selon les missions' },
  { titre: 'Qualiopi',           texte: 'Formation professionnelle certifiée' },
];
---

<Layout
  title="JANUS | Accompagnement international des entreprises | France & Europe"
  description="JANUS accompagne les entreprises dans leurs projets internationaux : négociation, interprétation, coordination terrain, traduction et formation. Expertise France–Pologne, interventions en Europe."
  locale={locale}
  currentPath={currentPath}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-card { transition: border-color .2s ease; }
    .hp-card:hover { border-color: rgba(181,147,107,.6); }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    a { text-decoration: none !important; }
  </style>

  <!-- ① HERO -->
  <section style="background:#f7f5f2" class="pt-32 md:pt-40 pb-20 md:pb-28 px-6">
    <div class="max-w-4xl mx-auto">
      <p class="hp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-8 md:mb-10" style="color:#b5936b">
        Accompagnement international des entreprises
      </p>
      <h1 class="hp-serif font-light leading-[1.08] mb-8" style="font-size:clamp(2.4rem,6vw,4.5rem);color:#1a1a1a">
        Vos opérations internationales,<br class="hidden md:block" />
        sans barrière de langue ni de culture.
      </h1>
      <p class="hp-sans text-base md:text-lg max-w-2xl leading-[1.8] mb-8" style="color:rgba(26,26,26,0.65)">
        JANUS accompagne les entreprises dans leurs négociations, échanges et projets internationaux — de la préparation des échanges jusqu’à l’intervention sur le terrain.
      </p>
      <p class="hp-sans text-xs uppercase tracking-[0.2em] mb-12 flex items-center gap-3" style="color:#1a1a1a">
        <span class="inline-block w-8 h-px flex-shrink-0" style="background:#b5936b"></span>
        <span>Expertise France ↔ Pologne · Interventions en Europe</span>
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
        <a href="/fr/contact" class="hp-sans inline-block text-center px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
          Parler de votre projet
        </a>
        <a href="/fr/services" class="hp-sans hp-link inline-block text-center py-3 text-xs uppercase tracking-widest border-b" style="border-color:rgba(26,26,26,0.3);color:#1a1a1a">
          Découvrir nos services
        </a>
      </div>
    </div>
  </section>

  <!-- ② SITUATIONS -->
  <section class="bg-white py-20 md:py-28 px-6">
    <div class="max-w-5xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">Quand faire appel à JANUS ?</p>
      <h2 class="hp-serif font-light leading-tight mb-12 md:mb-16" style="font-size:clamp(1.9rem,4vw,3rem);color:#1a1a1a">
        Dans quelles situations intervenons-nous ?
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {situations.map(s => (
          <div class="hp-card flex flex-col bg-[#f7f5f2] border border-[#1a1a1a]/5 p-8 md:p-10">
            <p class="hp-serif font-light leading-none mb-6" style="font-size:2.5rem;color:#b5936b">{s.n}</p>
            <h3 class="hp-serif text-xl md:text-2xl font-light leading-snug mb-4" style="color:#1a1a1a">{s.titre}</h3>
            <p class="hp-sans text-sm leading-[1.8] mb-6" style="color:rgba(26,26,26,0.65)">{s.texte}</p>
            <a href="/fr/contact" class="hp-sans hp-link text-xs uppercase tracking-widest mt-auto" style="color:#b5936b">
              Parler de votre situation →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ SERVICES -->
  <section style="background:#f7f5f2" class="py-20 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">Nos services</p>
      <h2 class="hp-serif font-light leading-tight mb-6" style="font-size:clamp(1.9rem,4vw,3rem);color:#1a1a1a">
        Un seul partenaire pour vos échanges internationaux
      </h2>
      <p class="hp-sans text-base max-w-2xl leading-[1.8] mb-12 md:mb-16" style="color:rgba(26,26,26,0.65)">
        Selon votre projet, JANUS intervient ponctuellement ou accompagne vos équipes sur plusieurs étapes de l’opération.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((s, i) => (
          <a href={s.href} class="hp-card flex flex-col bg-white border border-[#1a1a1a]/10 p-8">
            <p class="hp-sans text-xs tracking-widest mb-5" style="color:rgba(26,26,26,0.35)">0{i + 1}</p>
            <h3 class="hp-serif text-xl md:text-2xl font-light leading-snug mb-4" style="color:#1a1a1a">{s.titre}</h3>
            <p class="hp-sans text-sm leading-[1.8]" style="color:rgba(26,26,26,0.65)">{s.texte}</p>
          </a>
        ))}
        <a href="/fr/services" class="hp-link flex items-center justify-center p-8 border" style="border-color:#b5936b">
          <span class="hp-sans text-xs uppercase tracking-widest" style="color:#1a1a1a">Découvrir tous nos services →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ④ EXPERTISE FRANCE–POLOGNE -->
  <section style="background:#1a1a1a" class="py-20 md:py-32 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-12 lg:gap-20">
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-6" style="color:#b5936b">Notre expertise historique</p>
        <h2 class="hp-serif font-light leading-none sm:whitespace-nowrap mb-10" style="font-size:clamp(2.2rem,6vw,4rem);color:white">
          France <span style="color:#b5936b">↔</span> Pologne
        </h2>
        <p class="hp-sans text-lg md:text-xl leading-[1.7] mb-6" style="color:rgba(255,255,255,0.9)">
          JANUS accompagne les entreprises françaises et polonaises dans leurs échanges commerciaux, industriels et opérationnels.
        </p>
        <p class="hp-sans text-sm md:text-base leading-[1.8] mb-10" style="color:rgba(255,255,255,0.6)">
          Négociation, interprétation, coordination, accompagnement sur le terrain et communication interculturelle : nous intervenons lorsque la langue, les différences culturelles ou la complexité opérationnelle risquent de ralentir un projet.
        </p>
        <a href="/fr/marches/pologne" class="hp-sans inline-block text-center px-10 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
          Votre projet <span class="whitespace-nowrap">France–Pologne&nbsp;→</span>
        </a>
      </div>
      <ul class="self-center border-t" style="border-color:rgba(181,147,107,0.3)">
        {pologneListe.map(item => (
          <li class="hp-sans text-sm md:text-base flex items-center gap-4 py-5 border-b" style="border-color:rgba(181,147,107,0.3);color:rgba(255,255,255,0.85)">
            <span class="inline-block w-1.5 h-1.5 flex-shrink-0" style="background:#b5936b"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ⑤ AUTRES MARCHÉS -->
  <section class="bg-white py-16 md:py-20 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
      <div>
        <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">Au-delà de la Pologne</p>
        <h2 class="hp-serif text-2xl md:text-3xl font-light leading-tight mb-4" style="color:#1a1a1a">Vos projets en Europe</h2>
        <p class="hp-sans text-sm leading-[1.8]" style="color:rgba(26,26,26,0.65)">
          JANUS accompagne également les entreprises dans leurs échanges avec d’autres marchés européens, en mobilisant les compétences linguistiques et interculturelles adaptées à chaque mission.
        </p>
      </div>
      <ul class="grid grid-cols-2 gap-3">
        {marches.map(m => (
          <li>
            <a href={m.href} class="hp-card hp-sans flex items-center justify-between border border-[#1a1a1a]/10 px-5 py-4 text-sm" style="color:#1a1a1a">
              {m.pays}
              <span style="color:#b5936b">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ⑥ CAS CONCRETS -->
  <section style="background:#f7f5f2" class="py-20 md:py-28 px-6">
    <div class="max-w-5xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">Sur le terrain</p>
      <h2 class="hp-serif font-light leading-tight mb-6" style="font-size:clamp(1.9rem,4vw,3rem);color:#1a1a1a">
        Des situations internationales concrètes
      </h2>
      <p class="hp-sans text-base max-w-2xl leading-[1.8] mb-12 md:mb-16" style="color:rgba(26,26,26,0.65)">
        Quelques exemples de missions réalisées, notamment dans le cadre de notre expertise France–Pologne.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {cas.map(c => (
          <div class="bg-white border-t-2 p-8" style="border-top-color:#b5936b">
            <p class="hp-sans text-[11px] uppercase tracking-[0.2em] mb-5" style="color:#b5936b">{c.secteur}</p>
            <p class="hp-serif text-lg md:text-xl font-light leading-snug" style="color:#1a1a1a">{c.texte}</p>
          </div>
        ))}
      </div>
      <a href="/fr/cas-clients" class="hp-sans hp-link inline-block text-xs uppercase tracking-widest border-b py-2" style="border-color:#b5936b;color:#1a1a1a">
        Voir nos cas clients →
      </a>
    </div>
  </section>

  <!-- ⑦ RÉASSURANCE -->
  <section style="background:#1a1a1a" class="py-14 md:py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10">
        {reassurance.map(r => (
          <li class="text-center">
            <span class="block w-6 h-px mx-auto mb-4" style="background:#b5936b"></span>
            <p class="hp-serif text-xl md:text-2xl font-light mb-2" style="color:#b5936b">{r.titre}</p>
            <p class="hp-sans text-xs leading-relaxed" style="color:rgba(255,255,255,0.6)">{r.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ⑧ CTA FINAL -->
  <section style="background:#f7f5f2" class="py-24 md:py-32 px-6 text-center">
    <div class="max-w-xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-8" style="color:#b5936b">Premier échange confidentiel</p>
      <h2 class="hp-serif text-4xl md:text-5xl font-light mb-6 leading-tight" style="color:#1a1a1a">
        Un projet international&nbsp;?<br/><em class="italic" style="color:#b5936b">Parlons-en.</em>
      </h2>
      <p class="hp-sans text-base mb-12 max-w-md mx-auto leading-[1.8]" style="color:rgba(26,26,26,0.65)">
        Expliquez-nous votre situation, le pays concerné et l’objectif de votre projet. Nous vous répondrons sous 24h.
      </p>
      <a href="/fr/contact" class="hp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
        Parler de votre projet →
      </a>
    </div>
  </section>

</Layout>
