---
import Layout from '../../layouts/Layout.astro';
import HeroVideo from '../../components/ui/HeroVideo.astro';
import Flag from '../../components/ui/Flag.astro';
import communLangues from '../../content/fr/langues/_commun.json';

const locale = 'fr';
const currentPath = '/';

// Cartes langues : une page dédiée par langue (/fr/langues/{slug}), liste commune à tout le site.
const langues = communLangues.langues.map((l) => ({ ...l, href: `/fr/langues/${l.slug}` }));

const services = [
  { titre: 'Accompagnement international', motsCles: ['Négociation', 'Coordination', 'Interculturel', 'Terrain'],      href: '/fr/services' },
  { titre: 'Interprétation',               motsCles: ['Réunions', 'Négociations', 'Visites de sites'],                  href: '/fr/services' },
  { titre: 'Traduction',                   motsCles: ['Documents', 'Contrats', 'Communication professionnelle'],        href: '/fr/services' },
  { titre: 'Formation',                    motsCles: ['Langues', 'Métiers', 'Communication interculturelle'],           href: '/fr/services' },
];

// Vidéo du Hero (Adobe Stock n° 286167621, sous licence) — version web muette, boucle de 11 s.
// Desktop : 1280×720 (WebM VP9 puis MP4 H.264). Mobile : recadrage portrait 540×960 (WebM VP9 puis MP4 H.264).
const heroVideo = {
  desktop: [
    { src: '/video/hero-720p.webm', type: 'video/webm' },
    { src: '/video/hero-720p.mp4',  type: 'video/mp4' },
  ],
  mobile: [
    { src: '/video/hero-mobile.webm', type: 'video/webm' },
    { src: '/video/hero-mobile.mp4',  type: 'video/mp4' },
  ],
  poster: {
    avif: '/video/hero-poster.avif',
    jpg: '/video/hero-poster.jpg',
    mobileAvif: '/video/hero-poster-mobile.avif',
    mobileJpg: '/video/hero-poster-mobile.jpg',
  },
};

const cas = [
  { secteur: 'Industrie · Allemagne ↔ Pologne',         resume: '5 jours · 18 techniciens' },
  { secteur: 'M&A · France ↔ Pologne',                  resume: '4 mois d’accompagnement' },
  { secteur: 'Réunions stratégiques · France ↔ Pologne', resume: 'Interprétation & accompagnement' },
];

const reassurance = [
  { titre: 'FR · EN · PL · DE · ES', texte: 'Services multilingues' },
  { titre: 'France & Europe',        texte: 'À distance et sur le terrain' },
  { titre: 'Confidentialité',        texte: 'NDA selon les missions' },
  { titre: 'Qualiopi',               texte: 'MICH est certifiée Qualiopi au titre de la catégorie actions de formation' },
];
---

<Layout
  title="JANUS | Accompagnement international & services multilingues B2B"
  description="JANUS accompagne les entreprises dans leurs projets internationaux : négociation, interprétation, coordination terrain, traduction et formation en anglais, polonais, allemand, espagnol et français."
  locale={locale}
  currentPath={currentPath}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
  <style is:global>
    .hp-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .hp-sans  { font-family: 'DM Sans', system-ui, sans-serif; }
    .hp-card { transition: border-color .2s ease, box-shadow .2s ease; }
    .hp-card:hover { border-color: rgba(181,147,107,.6); box-shadow: 0 10px 28px rgba(0,0,0,.05); }
    .hp-card:hover .hp-arrow { color: #b5936b; }
    .hp-link { transition: opacity .2s ease; }
    .hp-link:hover { opacity: .7; }
    a { text-decoration: none !important; }
  </style>

  <!-- ① HERO VIDÉO -->
  <HeroVideo
    desktop={heroVideo.desktop}
    mobile={heroVideo.mobile}
    poster={heroVideo.poster}
    pauseLabel="Mettre la vidéo en pause"
    playLabel="Lire la vidéo"
  >
    <div class="max-w-6xl mx-auto px-6 pt-8 pb-12 md:py-12">
      <div class="md:max-w-[44vw] xl:max-w-[640px]">
      <p class="hp-sans text-[11px] md:text-xs uppercase tracking-[0.3em] mb-5 md:mb-7 flex items-center gap-4" style="color:#c9a84c">
        <span class="hidden sm:inline-block w-10 h-px flex-shrink-0" style="background:#c9a84c" aria-hidden="true"></span>
        <span>International · Multilingue · Sur le terrain</span>
      </p>
      <h1 class="hp-serif font-light leading-[1.05] mb-6 md:mb-7" style="font-size:clamp(2.3rem,4.4vw,3.6rem);color:#f7f5f2">
        Vos projets internationaux.<br />
        <em class="italic" style="color:#c9a84c">Nous sommes à vos côtés.</em>
      </h1>
      <p class="hp-sans text-base md:text-lg max-w-xl leading-[1.7] mb-5" style="color:rgba(247,245,242,0.85)">
        Négociation, interprétation, coordination et accompagnement terrain pour vos opérations internationales.
      </p>
      <p class="hp-sans text-xs md:text-sm uppercase tracking-[0.4em] mb-8 md:mb-9" style="color:rgba(247,245,242,0.65)">
        FR · EN · PL · DE · ES
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8 xl:gap-10">
        <a href="/fr/contact" class="hp-sans inline-block text-center px-8 sm:px-12 md:px-7 xl:px-12 py-5 whitespace-nowrap text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#0d0d0d">
          Parler de votre projet →
        </a>
        <a href="/fr/services" class="hp-sans hp-link self-start sm:self-auto text-[11px] uppercase tracking-[0.25em] border-b pb-1 whitespace-nowrap" style="border-color:rgba(247,245,242,0.35);color:rgba(247,245,242,0.75)">
          Découvrir nos services
        </a>
      </div>
      </div>
    </div>
  </HeroVideo>

  <!-- ENTRÉE PAR LANGUE -->
  <section style="background:#f7f5f2" class="py-10 md:py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="hp-sans text-xs uppercase tracking-[0.3em] mb-6" style="color:#b5936b">Votre langue</h2>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {langues.map((l, i) => (
            <li class={i === langues.length - 1 ? 'col-span-2 sm:col-span-1' : ''}>
              <a href={l.href} class="hp-card flex flex-col items-start sm:flex-row sm:items-center gap-3 sm:gap-4 h-full bg-white border border-[#1a1a1a]/10 px-5 py-5 md:py-6">
                <Flag code={l.code as any} class="w-9 h-6" />
                <span class="hp-serif text-lg md:text-xl font-light leading-tight flex-1 min-w-0" style="color:#1a1a1a">{l.nom}</span>
                <span class="hp-arrow hp-sans text-sm transition-colors hidden sm:inline" style="color:rgba(26,26,26,0.3)" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
    </div>
  </section>

  <!-- ② SERVICES -->
  <section class="bg-white py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-12">
        <div>
          <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">Nos services</p>
          <h2 class="hp-serif font-light leading-tight" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">
            Votre projet. <em class="italic" style="color:#b5936b">Notre accompagnement.</em>
          </h2>
        </div>
        <a href="/fr/services" class="hp-sans hp-link self-start md:self-auto text-xs uppercase tracking-widest border-b py-2 flex-shrink-0" style="border-color:#b5936b;color:#1a1a1a">
          Découvrir nos services →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map((s, i) => (
          <a href={s.href} class={`hp-card flex flex-col border ${i === 0 ? 'bg-[#1a1a1a] border-[#b5936b] p-8 lg:-my-3 lg:py-11' : 'bg-[#f7f5f2] border-[#1a1a1a]/5 p-7'}`}>
            <p class="hp-serif font-light leading-none mb-5" style={`font-size:2rem;color:${i === 0 ? '#c9a84c' : '#b5936b'}`}>0{i + 1}</p>
            <h3 class="hp-sans text-sm font-medium uppercase tracking-[0.15em] leading-snug mb-4" style={`color:${i === 0 ? '#f7f5f2' : '#1a1a1a'}`}>{s.titre}</h3>
            <p class="hp-sans text-sm leading-[1.7] mb-5" style={`color:${i === 0 ? 'rgba(247,245,242,0.7)' : 'rgba(26,26,26,0.6)'}`}>{s.motsCles.join(' · ')}</p>
            <span class="hp-arrow hp-sans text-sm mt-auto transition-colors" style={`color:${i === 0 ? '#c9a84c' : 'rgba(26,26,26,0.3)'}`} aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ CAS CONCRETS -->
  <section style="background:#f7f5f2" class="py-14 md:py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8 md:mb-10">
        <div>
          <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-3" style="color:#b5936b">JANUS sur le terrain</p>
          <h2 class="hp-serif font-light leading-tight" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:#1a1a1a">
            Des missions internationales concrètes.
          </h2>
        </div>
        <a href="/fr/cas-clients" class="hp-sans hp-link self-start md:self-auto text-xs uppercase tracking-widest border-b py-2 flex-shrink-0" style="border-color:#b5936b;color:#1a1a1a">
          Voir nos cas clients →
        </a>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {cas.map(c => (
          <li class="bg-white border-t-2 px-7 py-6" style="border-top-color:#b5936b">
            <p class="hp-sans text-[11px] uppercase tracking-[0.2em] mb-3" style="color:#b5936b">{c.secteur}</p>
            <p class="hp-serif text-xl md:text-2xl font-light leading-snug" style="color:#1a1a1a">{c.resume}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ④ EXPERTISE FRANCE–POLOGNE -->
  <section class="bg-white py-14 md:py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="bg-[#f7f5f2] border-l-2 p-8 md:p-10 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 md:gap-12 md:items-center" style="border-left-color:#b5936b">
        <div>
          <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-4" style="color:#b5936b">Une expertise particulière</p>
          <h2 class="hp-serif font-light leading-none mb-5" style="font-size:clamp(2rem,4.5vw,3rem);color:#1a1a1a">
            France <span style="color:#b5936b">↔</span> Pologne
          </h2>
          <p class="hp-sans text-sm md:text-base leading-[1.8] max-w-xl" style="color:rgba(26,26,26,0.65)">
            Une expérience particulière des projets franco-polonais : négociation, interprétation, coordination, traduction et accompagnement terrain.
          </p>
        </div>
        <a href="/fr/pologne" class="hp-sans inline-block text-center px-8 py-4 text-xs uppercase tracking-widest border hover:bg-[#b5936b] transition-colors" style="border-color:#b5936b;color:#1a1a1a">
          Découvrir notre expertise <span class="whitespace-nowrap">France–Pologne&nbsp;→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ⑦ RÉASSURANCE -->
  <section style="background:#1a1a1a" class="py-14 md:py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10">
        {reassurance.map(r => (
          <li class="text-center">
            <span class="block w-6 h-px mx-auto mb-4" style="background:#b5936b"></span>
            <p class="hp-serif text-xl md:text-2xl font-light mb-2" style="color:#b5936b">{r.titre}</p>
            <p class="hp-sans text-xs leading-relaxed" style="color:rgba(255,255,255,0.6)">{r.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ⑧ CTA FINAL -->
  <section style="background:#f7f5f2" class="py-24 md:py-32 px-6 text-center">
    <div class="max-w-xl mx-auto">
      <p class="hp-sans text-xs uppercase tracking-[0.3em] mb-8" style="color:#b5936b">Premier échange confidentiel</p>
      <h2 class="hp-serif text-4xl md:text-5xl font-light mb-6 leading-tight" style="color:#1a1a1a">
        Un projet international&nbsp;?<br/><em class="italic" style="color:#b5936b">Parlons-en.</em>
      </h2>
      <p class="hp-sans text-base mb-12 max-w-md mx-auto leading-[1.8]" style="color:rgba(26,26,26,0.65)">
        Expliquez-nous votre projet, les langues concernées et votre objectif.
      </p>
      <a href="/fr/contact" class="hp-sans inline-block px-12 py-5 text-xs md:text-sm font-medium uppercase tracking-widest hover:opacity-85 transition-opacity" style="background:#b5936b;color:#1a1a1a">
        Parler de votre projet →
      </a>
    </div>
  </section>

</Layout>
