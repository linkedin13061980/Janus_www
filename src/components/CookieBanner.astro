---
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 bg-anthracite-light border-t border-gold/30 px-4 py-4 hidden"
>
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-white/70 text-sm">
      {t(locale, 'cookies.message')}
      <a href={`/${locale}/cookies`} class="text-gold hover:underline ml-1">{t(locale, 'cookies.learn_more')}</a>
    </p>
    <div class="flex gap-3 shrink-0">
      <button id="cookie-decline" class="px-4 py-2 text-sm text-white/50 hover:text-white border border-white/20 hover:border-white/40 transition-colors">
        {t(locale, 'cookies.decline')}
      </button>
      <button id="cookie-accept" class="px-4 py-2 text-sm bg-gold text-anthracite font-semibold hover:bg-gold-light transition-colors">
        {t(locale, 'cookies.accept')}
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const consent = localStorage.getItem('cookie_consent');

  // Suppression des cookies Google Analytics (_ga, _ga_*) lorsque le consentement est absent, refusé ou retiré.
  // GA4 les dépose sur le domaine le plus large possible (ex. .agence-janus.fr) : on les efface sur chaque domaine parent.
  function clearAnalyticsCookies() {
    const names = document.cookie
      .split(';')
      .map((c) => c.split('=')[0].trim())
      .filter((n) => n === '_ga' || n.startsWith('_ga_'));
    if (!names.length) return;
    const parts = location.hostname.split('.');
    const domains = [''];
    for (let i = 0; i < parts.length - 1; i++) domains.push(`; domain=.${parts.slice(i).join('.')}`);
    const expired = '; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    names.forEach((n) => domains.forEach((d) => { document.cookie = `${n}=${expired}${d}`; }));
  }

  // Pas de consentement valide (aucun choix, refus, ou choix réinitialisé depuis la page Cookies) : purge au chargement.
  if (consent !== 'accepted') clearAnalyticsCookies();

  if (!consent) {
    banner?.classList.remove('hidden');
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem('cookie_consent', 'accepted');
    banner?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('cookie-accepted'));
  });

  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    localStorage.setItem('cookie_consent', 'declined');
    banner?.classList.add('hidden');
    clearAnalyticsCookies();
  });
</script>
