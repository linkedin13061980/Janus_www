---
import type { Locale } from '../i18n/utils';
import { t, localePath, localeNames } from '../i18n/utils';
import { localizedPath } from '../i18n/routes';
// Navigation EN/PL : /src/content/menu.json. Le FR garde son menu actuel (migration dans un chantier séparé).
import menu from '../content/menu.json';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const locales: Locale[] = ['fr', 'en', 'pl'];
const nav = locale === 'fr' ? null : menu[locale];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-anthracite/95 backdrop-blur border-b border-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={localePath(locale, '/')} class="flex items-center gap-2.5 sm:gap-3 group">
        <img src="/logo/janus-embleme-fond-sombre.svg" alt="" aria-hidden="true" width="36" height="40" class="h-[34px] sm:h-10 w-auto" />
        <span class="text-2xl font-serif font-bold text-gold tracking-widest group-hover:text-gold-light transition-colors">
          JANUS
        </span>
      </a>

      <!-- Navigation desktop -->
      {nav === null ? (
      <nav class="hidden xl:flex items-center gap-6">
        <a href={localePath(locale, '/')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.home')}</a>
        <a href={localePath(locale, '/services')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.services')}</a>
        <a href={localePath(locale, '/langues')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.langues')}</a>
        {locale === 'fr' && <a href={localePath(locale, '/pologne')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.francePologne')}</a>}
        <a href={localePath(locale, '/financement')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.financement')}</a>
        <a href={localePath(locale, '/a-propos')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.about')}</a>
        <a href={localePath(locale, '/contact')} class="px-4 py-2 bg-gold text-anthracite text-sm font-semibold uppercase tracking-wider whitespace-nowrap hover:bg-gold-light transition-colors">
          {t(locale, 'nav.contact')}
        </a>
      </nav>
      ) : (
      <nav class="hidden xl:flex items-center gap-6">
        {nav.header.map((item) => item.cta
          ? <a href={item.url} class="px-4 py-2 bg-gold text-anthracite text-sm font-semibold uppercase tracking-wider whitespace-nowrap hover:bg-gold-light transition-colors">{item.label}</a>
          : <a href={item.url} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{item.label}</a>)}
      </nav>
      )}

      <!-- Switcher de langue -->
      <div class="flex items-center gap-1 ml-4">
        {locales.map((loc) => {
          // Uniquement les versions existantes ; sinon la langue est affichée désactivée (pas de 404).
          const href = loc === locale ? `/${loc}${currentPath}` : localizedPath(currentPath, loc);
          return href ? (
            <a
              href={href}
              class={`px-2 py-1 text-xs font-semibold uppercase tracking-wider transition-colors ${
                loc === locale
                  ? 'text-gold border-b border-gold'
                  : 'text-white/50 hover:text-white'
              }`}
            >
              {localeNames[loc]}
            </a>
          ) : (
            <span class="px-2 py-1 text-xs font-semibold uppercase tracking-wider text-white/20 cursor-default" aria-disabled="true">
              {localeNames[loc]}
            </span>
          );
        })}
      </div>

      <!-- Burger mobile -->
      <button
        id="menu-toggle"
        class="xl:hidden text-white/70 hover:text-white ml-3"
        aria-label="Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-gold/20 bg-anthracite">
    {nav === null ? (
    <nav class="px-4 py-4 flex flex-col gap-3">
      <a href={localePath(locale, '/')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.home')}</a>
      <a href={localePath(locale, '/services')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.services')}</a>
      <a href={localePath(locale, '/langues')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.langues')}</a>
      {locale === 'fr' && <a href={localePath(locale, '/pologne')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.francePologne')}</a>}
      <a href={localePath(locale, '/financement')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.financement')}</a>
      <a href={localePath(locale, '/a-propos')} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.about')}</a>
      <a href={localePath(locale, '/contact')} class="text-sm text-gold hover:text-gold-light transition-colors uppercase tracking-wider whitespace-nowrap">{t(locale, 'nav.contact')}</a>
    </nav>
    ) : (
    <nav class="px-4 py-4 flex flex-col gap-3">
      {nav.mobile.map((item) => item.cta
        ? <a href={item.url} class="text-sm text-gold hover:text-gold-light transition-colors uppercase tracking-wider whitespace-nowrap">{item.label}</a>
        : <a href={item.url} class="text-sm text-white/70 hover:text-white transition-colors uppercase tracking-wider whitespace-nowrap">{item.label}</a>)}
    </nav>
    )}
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
