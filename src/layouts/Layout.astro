---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { Locale } from '../i18n/utils';
import { hreflangPaths } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  currentPath?: string;
  ogImage?: string;
  canonical?: string;
  // true : page exclue de l'indexation (ex. page de remerciement /fr/merci)
  noindex?: boolean;
  // false : page sans équivalent EN/PL → aucune balise hreflang (évite des alternates erronés)
  alternates?: boolean;
}

const {
  title,
  description,
  locale,
  currentPath = '/',
  ogImage = 'https://agence-janus.fr/og-image.jpg',
  canonical,
  noindex = false,
  alternates = true,
} = Astro.props;

const canonicalUrl = canonical ?? `https://agence-janus.fr/${locale}${currentPath}`;
// hreflang : uniquement vers les versions linguistiques qui existent réellement (URL traduites comprises, ex. cas clients).
const hreflang = alternates ? hreflangPaths(currentPath) : null;
const alternateLinks = hreflang
  ? (Object.entries(hreflang) as [Locale, string][]).map(([loc, path]) => [loc, `https://agence-janus.fr${path}`])
  : [];
// Google Analytics 4 — propriété JANUS. ID fixé dans le code : aucune variable d'environnement ne peut réintroduire l'ancienne propriété.
const GA_ID = 'G-DYN5KDTKK8';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- hreflang -->
    {alternateLinks.map(([loc, href]) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    {hreflang?.fr && <link rel="alternate" hreflang="x-default" href={`https://agence-janus.fr${hreflang.fr}`} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="JANUS" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : locale === 'en' ? 'en_GB' : 'pl_PL'} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts — préchargement -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Raleway:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-anthracite text-white">
    <Header locale={locale} currentPath={currentPath} />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />

    <!-- Google Analytics 4 — aucun script Google n'est chargé avant le consentement (bandeau cookies) -->
    {GA_ID && (
      <script define:vars={{ GA_ID }}>
        function loadGA() {
          if (window.gtag) return;
          window.dataLayer = window.dataLayer || [];
          // gtag.js n'interprète que l'objet `arguments` (un tableau serait ignoré).
          window.gtag = function () { window.dataLayer.push(arguments); };
          // Consent Mode v2 : mesure d'audience acceptée ; aucun usage publicitaire.
          window.gtag('consent', 'default', {
            analytics_storage: 'granted',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          window.gtag('js', new Date());
          window.gtag('config', GA_ID);
          const s = document.createElement('script');
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          s.async = true;
          document.head.appendChild(s);
        }

        if (localStorage.getItem('cookie_consent') === 'accepted') {
          loadGA();
        } else {
          window.addEventListener('cookie-accepted', loadGA, { once: true });
        }
      </script>
    )}
  </body>
</html>
