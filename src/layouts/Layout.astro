---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { Locale } from '../i18n/utils';
import { hreflangPaths } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  currentPath?: string;
  ogImage?: string;
  canonical?: string;
  // true : page exclue de l'indexation (ex. page de remerciement /fr/merci)
  noindex?: boolean;
  // false : page sans équivalent EN/PL → aucune balise hreflang (évite des alternates erronés)
  alternates?: boolean;
}

const {
  title,
  description,
  locale,
  currentPath = '/',
  ogImage = 'https://agence-janus.fr/og-image.jpg',
  canonical,
  noindex = false,
  alternates = true,
} = Astro.props;

const canonicalUrl = canonical ?? `https://agence-janus.fr/${locale}${currentPath}`;
// hreflang : uniquement vers les versions linguistiques qui existent réellement (URL traduites comprises, ex. cas clients).
const hreflang = alternates ? hreflangPaths(currentPath) : null;
const alternateLinks = hreflang
  ? (Object.entries(hreflang) as [Locale, string][]).map(([loc, path]) => [loc, `https://agence-janus.fr${path}`])
  : [];
// Balises Google — configuration unique. ID fixés dans le code : aucune variable d'environnement ne peut réintroduire l'ancienne propriété.
// Google Ads : à renseigner une fois l'action de conversion créée (ID « AW-… » et libellé) ; tant que null, rien n'est chargé ni envoyé.
const TAGS = {
  ga: 'G-DYN5KDTKK8',
  ads: null as string | null,
  adsConversionLabel: null as string | null,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Balises Google — Consent Mode v2 basique : aucun script Google avant consentement (bandeau cookies).
         Chargé dans <head> pour que gtag existe avant tout événement de la page (ex. conversion sur /fr/merci). -->
    <script is:inline define:vars={{ TAGS }}>
      window.janusTags = TAGS;
      function loadGoogleTags() {
        if (window.gtag) return;
        window.dataLayer = window.dataLayer || [];
        // gtag.js n'interprète que l'objet `arguments` (un tableau serait ignoré).
        window.gtag = function () { window.dataLayer.push(arguments); };
        // Tout est refusé par défaut, puis la mesure d'audience est accordée (consentement donné).
        // Les signaux publicitaires restent refusés tant que le bandeau ne couvre pas la publicité.
        window.gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
        window.gtag('js', new Date());
        window.gtag('config', TAGS.ga);
        if (TAGS.ads) window.gtag('config', TAGS.ads);
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + TAGS.ga;
        s.async = true;
        document.head.appendChild(s);
      }
      var consentement = null;
      try { consentement = localStorage.getItem('cookie_consent'); } catch (e) {}
      if (consentement === 'accepted') loadGoogleTags();
      else window.addEventListener('cookie-accepted', loadGoogleTags, { once: true });
    </script>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- hreflang -->
    {alternateLinks.map(([loc, href]) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    {hreflang?.fr && <link rel="alternate" hreflang="x-default" href={`https://agence-janus.fr${hreflang.fr}`} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="JANUS" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : locale === 'en' ? 'en_GB' : 'pl_PL'} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts — préchargement -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Raleway:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-anthracite text-white">
    <Header locale={locale} currentPath={currentPath} />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />

  </body>
</html>
